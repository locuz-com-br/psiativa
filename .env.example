# ─────────────────────────────────────────────
# PsiAtiva Landing Page — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All keys prefixed with PUBLIC_ are exposed to the client-side.

# Web3Forms — Contact form email delivery (https://web3forms.com/)
PUBLIC_WEB3FORMS_ACCESS_KEY=your_key_here

# Google Analytics - Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GOOGLE_ANALYTICS_ID=

# Google Tag Manager - Container ID (e.g. GTM-XXXXXXX)
PUBLIC_GTM_ID=GTM-TFTX34PC

# Microsoft Clarity - Project ID
PUBLIC_CLARITY_ID=

# Formbricks - use Workspace ID for new integrations.
# Environment ID remains supported for the migrated legacy App Survey.
PUBLIC_FORMBRICKS_APP_URL=https://app.formbricks.com
PUBLIC_FORMBRICKS_WORKSPACE_ID=
PUBLIC_FORMBRICKS_ENV_ID=
PUBLIC_FORMBRICKS_LINK_SURVEY_ID=xnnk82ql3hkany9kmlkp47oi

# ────────────────────────────────────────────────────
# Captura de leads — Calculadora (/calculadora) + Quiz (/quiz)
# ────────────────────────────────────────────────────
# Webhook n8n de captura do lead (POST → hCaptcha → dedup → leads_master + handoff Renata).
# UM webhook compartilhado pelas duas ferramentas; cada uma manda um `source` distinto:
#   calculadora → source="roi_calculator"   (ver plans/calculadora-capture-contract.md)
#   quiz        → source="quiz_diagnostico"  (ver plans/quiz-capture-contract.md)
# NÃO é Web3Forms (aquele é só o formulário de contato).
PUBLIC_N8N_CAPTURE_WEBHOOK=

# hCaptcha — SITE keys (públicas, vão pro bundle do navegador). O SECRET correspondente
# fica SÓ no n8n (HCAPTCHA_SECRET, sem prefixo PUBLIC_) — nunca coloque o secret aqui,
# senão ele vaza no JS do cliente.
#
# ⛔ CORRIGIDO 2026-08-24: o hCaptcha emite UM secret por CONTA, não um por site.
# A versão anterior deste comentário dizia que a sitekey e o secret tinham que ser
# "do MESMO site", e foi essa premissa que levou alguém a provisionar um
# `HCAPTCHA_SECRET_RAIOX` que nunca existiu — o valor guardado com esse nome era a
# SITEKEY do Raio-X. As duas sitekeys abaixo verificam contra o MESMO HCAPTCHA_SECRET.
# O que a sitekey dedicada dá é a capacidade de bloquear/rotacionar UMA ferramenta sem
# derrubar a outra. O que precisa bater é a CONTA: uma sitekey de outra conta devolve
# `sitekey-secret-mismatch` no siteverify e a captura morre num 403 antes de salvar o lead.

# Widget do /quiz e da /calculadora.
PUBLIC_HCAPTCHA_SITE_KEY=

# Widget do /raio-x-site (Sprint 17a, Fase 5). Sitekey DEDICADA — é um UUID, e é
# pública por construção: ela aparece no HTML da página, como toda sitekey.
# ⛔ NUNCA ponha o secret aqui. Se o valor não começar com `ES_` nem `0x`, é sitekey;
# se começar, você está prestes a publicar o secret no bundle do navegador.
PUBLIC_HCAPTCHA_SITEKEY_RAIOX=

# DEV-only: mostra a revelação gated da calculadora com números-mock (valor de TABELA, nunca Pix).
# Eliminado do build de produção. Use só para revisar a UI localmente.
# PUBLIC_CALC_DEV_MOCK=true

# ────────────────────────────────────────────────────
# Captura — Raio-X do Site (/raio-x-site), Sprint 17a
# ────────────────────────────────────────────────────
# ⛔ O Raio-X NÃO usa o PUBLIC_N8N_CAPTURE_WEBHOOK acima. Ele tem DOIS webhooks
# dedicados, porque o fluxo tem dois round-trips e não um:
#
#   1. /scan   → verifica o hCaptcha → cache por domínio → fetch + score
#                💰 custa 1 Browser Rendering + 1 chamada LLM por domínio novo
#   2. /reveal → recebe nome + telefone, grava a lead, devolve o R$
#
# A captura tem que ser o ÚLTIMO passo (5.3) e o captcha tem que vir ANTES da
# chamada cara (4.2). Não dá pra ter as duas coisas num POST só.
# Contrato completo: plans/audit-site-capture-contract.md §2.
#
# ⚠️ plans/audit-site-capture-contract.md §1 e TASKS.md 6.2 ainda dizem
# "reusar o webhook compartilhado". Estão DESATUALIZADOS: os dois workflows
# dedicados foram construídos em 2026-08-21 e são o que está de pé.
#
# Forma: https://<host-do-tunel>/webhook/psiativa-raio-x-scan
PUBLIC_N8N_RAIOX_SCAN_WEBHOOK=
PUBLIC_N8N_RAIOX_REVEAL_WEBHOOK=

# DEV-only: simula scan + reveal sem backend, pra revisar a UI localmente.
# Eliminado do build de produção.
# PUBLIC_RAIOX_DEV_MOCK=true

# DEV-only: simula o handoff do quiz sem backend (não envia ao webhook).
# Eliminado do build de produção. Use só para revisar a UI localmente.
# PUBLIC_QUIZ_DEV_MOCK=true

# DEV-only: mostra o engine de formulários nativos (/diagnostico) com payload-mock
# no console, sem enviar ao webhook. Eliminado do build de produção.
# PUBLIC_FORMS_DEV_MOCK=true

# ── WhatsApp click beacon (consent-free click counter) ──────────────────────
# n8n webhook that receives WhatsApp-CTA clicks. Empty = beacon disabled.
# The webhook MUST accept Content-Type: text/plain and JSON-parse the RAW body
# (sendBeacon uses text/plain to stay a CORS-simple request — no preflight),
# and MUST discard the caller IP: an IP would make the payload personal data
# under LGPD, which would force consent-gating and destroy the measurement.
PUBLIC_BEACON_ENDPOINT=
# Stable label so one endpoint can serve several landing pages.
PUBLIC_BEACON_SITE_ID=psiativa-lp

# ── Meta Pixel + Conversions API ────────────────────────────────────────────
# Pixel / Dataset ID from Events Manager -> Data Sources (15-16 digits).
# PUBLIC_ = ships in the bundle, which is correct and expected for a pixel id.
PUBLIC_META_PIXEL_ID_1=
PUBLIC_META_PIXEL_ID_2=
PUBLIC_META_PIXEL_ID_3=
# n8n webhook that forwards conversions to the Graph API (server-side CAPI leg).
PUBLIC_META_CAPI_ENDPOINT=
#
# 🔴 The CAPI ACCESS TOKEN is a SECRET and does NOT belong in this file.
# It grants write access to the ad account, and every PUBLIC_ var is readable by
# any visitor. It lives in n8n's own environment:
#   META_CAPI_ACCESS_TOKEN     - System User token with access to EVERY pixel above
#   META_PIXEL_IDS             - comma-separated, must match the PUBLIC_ ids above
#   META_CAPI_TEST_EVENT_CODE  - setup only, REMOVE once verified
#   META_GRAPH_VERSION         - e.g. v21.0
# If the pixels live in different Business Managers one token cannot reach both;
# use META_CAPI_TARGETS as JSON [{"pixel_id":"...","token":"..."}] instead.

# ── FTP deploy (cPanel, scoped) ─────────────────────────────────────────────
# ⛔ Transport is FTP, NEVER SSH/scp/rsync. The origin is a SHARED hosting account
# under a process cap that refuses processes ACCOUNT-WIDE when exceeded, taking
# down every site on it together — not just this one.
# ⚠️ SSH connects fine on this host. Working is not the same as allowed.
#
# 🔴 THIS REPOSITORY IS PUBLIC. Real values live in the untracked `.env` only.
# Do not paste the origin hostname here: this site is served through Cloudflare,
# so the origin address is a WAF-bypass route, and a public repo publishes it
# permanently — a history rewrite does NOT un-publish it.
#
# The login is a per-directory FTP account jailed to THIS docroot, created over
# cPanel API2 `Ftp::addftp` and confirmed with `Ftp::listftp` rather than assumed.
# ⚠️ A same-apex sibling shares the parent directory — the jail is the LEAF
# docroot precisely so that `--prune` can never reach it.
CPANEL_FTP_HOST=
CPANEL_FTP_PORT=21
CPANEL_FTP_USER=deploy@<this-domain>
CPANEL_FTP_PASSWORD=
# A chrooted login's own path is "/" and can never name the host, so the docroot
# identity check is waived only because this is DECLARED.
CPANEL_FTP_SCOPED=true
# ⛔ This host advertises AUTH TLS in FEAT and then 500s on every scheme. The
# script fails closed; this is how the plaintext choice is stated out loud.
CPANEL_FTP_TLS=false
# Docroot relative to the FTP home. Ignored while CPANEL_FTP_SCOPED=true.
CPANEL_DOCROOT_BASE=
# Used only for the read-only process-quota preflight.
CPANEL_API_USER=
CPANEL_API_TOKEN=
# Comma-separated sibling docroots on the same account. Only used to make a
# misroute message actionable — leave empty here, set the real list in .env.
CPANEL_SIBLING_SITES=
