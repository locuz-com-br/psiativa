{
  "name": "psiativa",
  "version": "1.0.0",
  "description": "A specialized Healthcare patient acquisition landing page built with Astro, React & Tailwind CSS.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:clean": "rm -rf dist .astro && astro build",
    "deploy:check": "node scripts/deploy-ftp.mjs",
    "deploy": "node scripts/deploy-ftp.mjs --publish",
    "deploy:prune": "node scripts/deploy-ftp.mjs --publish --prune",
    "deploy:status": "node scripts/deploy-ftp.mjs --verify"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/react": "^5.0.2",
    "@formbricks/js": "^5.0.0",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@tailwindcss/vite": "^4.2.2",
    "gsap": "^3.14.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-phone-number-input": "^3.4.16",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "astro": "^6.1.5",
    "basic-ftp": "^5.3.1",
    "dotenv": "^16.6.1",
    "typescript": "^5.7.0"
  }
}
