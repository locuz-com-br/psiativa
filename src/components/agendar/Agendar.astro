---
// /agendar (Sprint 11 F5). Talks only to the WF-H facade (SITE_CONFIG.agenda.endpoint).
// Copy: `agendar.*` in translations.json. The PT values are rendered here as the static fallback AND handed to the
// script as its fallback map, so the two copies cannot drift. Plan: plans/sprint-11-closer-booking-engine-gcal-sdr.md §F5.
import translations from "../../data/translations.json";
import { SITE_CONFIG } from "../../config/site.config";
import LINKS from "../../constants/links";
import ParticleField from "../ui/ParticleField.astro";

const A = translations.agendar;
const PT: Record<string, string> = {};
const walk = (node: Record<string, any>, prefix: string) => {
  for (const [key, value] of Object.entries(node)) {
    if (value && typeof value === "object" && "pt" in value) PT[prefix + key] = value.pt;
    else if (value && typeof value === "object") walk(value, `${prefix}${key}.`);
  }
};
walk(A, "");
const endpoint = SITE_CONFIG.agenda.endpoint;
const consent = SITE_CONFIG.agenda.consentVersion;
---

<section class="ag-section">
  <!-- Fix 5.1: the home hero's background (same gradient + particle field), running up under the navbar. -->
  <div class="ag-bg" aria-hidden="true">
    <ParticleField count={200} opacity={0.45} parallax />
  </div>
  <div class="container">
    <div id="agendar" class="ag-card" data-endpoint={endpoint} data-consent={consent}>
      <aside class="ag-info">
      <h1 id="ag-title" tabindex="-1" data-ag-key="pub.title">{A.pub.title.pt}</h1>
      <p id="ag-lead" class="ag-lead" data-ag-key="pub.lead">{A.pub.lead.pt}</p>
      <ul id="ag-meta" class="ag-meta">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
          <span data-ag-key="info.duracao">{A.info.duracao.pt}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="13" height="12" rx="2" /><path d="m16 10 5-3v10l-5-3" /></svg>
          <span data-ag-key="info.meet">{A.info.meet.pt}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
          <span data-ag-key="grid.tz">{A.grid.tz.pt}</span>
        </li>
      </ul>
      <!-- Fix 7: the whole box changes the time (no inner button); the "Trocar" link sits under the submit. -->
      <button type="button" id="ag-picked" class="ag-picked" data-ag-aria="grid.change_aria" hidden>
        <span id="ag-picked-text"></span>
      </button>

      <a
        id="ag-wa"
        class="btn btn-primary ag-wa"
        href={LINKS.socials.whatsapp}
        target="_blank"
        rel="noopener"
        data-whatsapp-cta
        data-ag-key="wa"
        hidden>{A.wa.pt}</a
      >

      </aside>

      <div class="ag-main">
      <div id="ag-manage" class="ag-manage" hidden>
        <p id="ag-manage-title" class="ag-manage-title"></p>
        <p id="ag-manage-ask" data-ag-key="man.ask">{A.man.ask.pt}</p>
        <div class="ag-actions">
          <button type="button" id="ag-trocar" class="btn btn-primary" data-ag-key="man.trocar">{A.man.trocar.pt}</button>
          <button type="button" id="ag-cancelar" class="btn btn-outline" data-ag-key="man.cancelar">{A.man.cancelar.pt}</button>
        </div>
        <div id="ag-confirm" class="ag-confirm" hidden>
          <p id="ag-confirm-text"></p>
          <div class="ag-actions">
            <button type="button" id="ag-sim" class="btn btn-primary" data-ag-key="man.sim">{A.man.sim.pt}</button>
            <button type="button" id="ag-outro" class="btn btn-outline" data-ag-key="man.outro">{A.man.outro.pt}</button>
          </div>
        </div>
      </div>

      <p id="ag-status" class="ag-status" role="status" aria-live="polite" data-ag-key="st.carregando">
        {A.st.carregando.pt}
      </p>
      <div id="ag-grid" class="ag-grid" hidden>
        <div class="ag-cal">
          <div class="ag-cal-head">
            <h2 id="ag-month" class="ag-month"></h2>
            <div class="ag-cal-nav">
              <button type="button" id="ag-prev" class="ag-nav" data-ag-aria="grid.prev">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
              </button>
              <button type="button" id="ag-next" class="ag-nav" data-ag-aria="grid.next">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
              </button>
            </div>
          </div>
          <div id="ag-weekdays" class="ag-weekdays" aria-hidden="true"></div>
          <div id="ag-days" class="ag-days" role="group"></div>
        </div>
        <div id="ag-times" class="ag-times" hidden>
          <p id="ag-times-title" class="ag-times-title"></p>
          <div id="ag-slots" class="ag-slots" role="group"></div>
        </div>
      </div>

      <form id="ag-form" class="ag-form" novalidate hidden data-clarity-mask="true">
        <div id="ag-public-fields">
          <label class="ag-field">
            <span data-ag-key="form.name">{A.form.name.pt}</span>
            <input id="ag-name" name="name" autocomplete="name" maxlength="120" data-ag-ph="form.name_ph" placeholder={A.form.name_ph.pt} />
            <small id="ag-name-err" class="ag-field-err" role="alert" hidden></small>
          </label>
          <label class="ag-field">
            <span data-ag-key="form.phone">{A.form.phone.pt}</span>
            <input id="ag-phone" name="phone" type="tel" autocomplete="tel-national" inputmode="numeric" maxlength="15" placeholder="(21) 99999-9999" />
            <small class="ag-help" data-ag-key="form.phone_help">{A.form.phone_help.pt}</small>
            <small id="ag-phone-err" class="ag-field-err" role="alert" hidden></small>
          </label>
        </div>
        <div id="ag-email-field">
          <label class="ag-field">
            <span data-ag-key="form.email">{A.form.email.pt}</span>
            <input id="ag-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="160" spellcheck="false" autocapitalize="off" data-ag-ph="form.email_ph" placeholder={A.form.email_ph.pt} />
            <small class="ag-help" data-ag-key="form.email_help">{A.form.email_help.pt}</small>
            <small id="ag-email-err" class="ag-field-err" role="alert" hidden></small>
          </label>
        </div>
        <div id="ag-consent-field">
          <label class="ag-consent">
            <!-- Checkbox: Uiverse.io by SelfMadeSystem (green-bobcat-29), recoloured. The input stays in the
                 accessibility tree (transparent, on top of the drawing), not display:none. -->
            <span class="ag-check">
              <input id="ag-consent" type="checkbox" />
              <svg viewBox="0 0 64 64" aria-hidden="true">
                <path
                  d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                  pathLength="575.0541381835938"
                  class="ag-check-path"></path>
              </svg>
            </span>
            <span
              ><span data-ag-key="form.consent">{A.form.consent.pt}</span>
              <a class="ag-inline" href={LINKS.legal.terms} target="_blank" rel="noopener" data-ag-key="form.terms"
                >{A.form.terms.pt}</a
              >
              <span data-ag-key="form.and">{A.form.and.pt}</span>
              <a class="ag-inline" href={LINKS.legal.privacy} target="_blank" rel="noopener" data-ag-key="form.privacy"
                >{A.form.privacy.pt}</a
              ></span
            >
          </label>
        </div>
        <p id="ag-erro" class="ag-erro" role="alert" hidden></p>
        <div class="ag-cta">
          <button type="submit" id="ag-submit" class="btn btn-primary ag-submit" disabled data-ag-key="form.submit">
            {A.form.submit.pt}
          </button>
          <button type="button" id="ag-change" class="ag-change" data-ag-key="grid.change">{A.grid.change.pt}</button>
        </div>
      </form>

      <div id="ag-done" class="ag-done" hidden>
        <h2 id="ag-done-title"></h2>
        <p id="ag-done-text"></p>
      </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="ag-pt" set:html={JSON.stringify(PT)} />

<script>
  import {
    WHATSAPP_STATES, dayLabel, fill, hourLabel, monthLabel, weekdayInitials, normalizePhone, parseToken, refusalKey, slotLabel,
    validEmail, validName, type Lang,
  } from "../../lib/agendar";
  import { afterPress, maskPhone, sanitizeEmail } from "../../lib/fields";

  type Slot = { starts_at: string };
  type Dia = { dia: string; slots: Slot[] };
  type Answer = Record<string, any>;

  const root = document.getElementById("agendar")!;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const PT: Record<string, string> = JSON.parse($("ag-pt").textContent || "{}");
  const i18n = () => (window as any).__siteI18n;
  const lang = (): Lang => (i18n()?.currentLang?.() === "en" ? "en" : "pt");
  const t = (key: string, vars: Record<string, string> = {}) => fill(i18n()?.t?.(`agendar.${key}`) || PT[key] || "", vars);

  /** Every script-set string goes through here, so a language toggle can re-render it. */
  function say(el: HTMLElement, key: string, vars: Record<string, string> = {}) {
    el.dataset.agKey = key;
    el.dataset.agVars = JSON.stringify(vars);
    el.textContent = t(key, vars);
  }
  /** Elements with no slot-derived vars (header, form labels): safe to re-run at any time. */
  function relabelStatic() {
    root.querySelectorAll<HTMLElement>("[data-ag-aria]").forEach((el) => el.setAttribute("aria-label", t(el.dataset.agAria!)));
    root.querySelectorAll<HTMLInputElement>("[data-ag-ph]").forEach((el) => (el.placeholder = t(el.dataset.agPh!)));
    root.querySelectorAll<HTMLElement>("[data-ag-key]").forEach((el) => {
      if (el.dataset.agSlot === undefined) el.textContent = t(el.dataset.agKey!, JSON.parse(el.dataset.agVars || "{}"));
    });
  }
  function relabel() {
    root.querySelectorAll<HTMLElement>("[data-ag-key]").forEach((el) => {
      const vars = JSON.parse(el.dataset.agVars || "{}");
      if (el.dataset.agSlot) vars.label = slotLabel(el.dataset.agSlot, lang());
      el.textContent = t(el.dataset.agKey!, vars);
    });
    renderGrid();
  }

  const state = {
    token: null as string | null,
    modo: "publico" as string,
    dias: [] as Dia[],
    dia: "",
    mes: "",
    slot: "",
    managing: false,
    busy: false,
  };

  // ── This browser's booking (Juan, F5 review): "already booked" shows the time only to the browser that booked.
  // Another device gets no time (anyone can type any number on the public page).
  const MEMO = "psiativa-agendar";
  function remember(startsAt: string, phone: string | null) {
    try { localStorage.setItem(MEMO, JSON.stringify({ starts_at: startsAt, phone })); } catch {}
  }
  function forget() {
    try { localStorage.removeItem(MEMO); } catch {}
  }
  /** The booked time this browser saved, if it is still ahead and (on the public page) for the same number. */
  function recalled(phone: string | null): string | null {
    try {
      const memo = JSON.parse(localStorage.getItem(MEMO) || "null");
      if (!memo?.starts_at || Date.parse(memo.starts_at) <= Date.now()) return null;
      if (phone && memo.phone && memo.phone !== phone) return null;
      return String(memo.starts_at);
    } catch {
      return null;
    }
  }
  let lastPhone: string | null = null;

  // ── Network: the facade, or a dev-only fixture ─────────────────────────
  let fixture: Record<string, Answer> | null = null;
  async function call(body: Answer): Promise<Answer> {
    if (fixture) {
      const answer = fixture[body.op === "gerenciar" ? `gerenciar_${body.acao}` : body.op] || fixture[body.op];
      await new Promise((r) => setTimeout(r, Number(fixture.delay ?? 250)));
      return answer || { ok: false, resultado: "indisponivel" };
    }
    try {
      const response = await fetch(root.dataset.endpoint!, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(body),
        signal: AbortSignal.timeout(15_000),
      });
      const answer = await response.json();
      return answer && typeof answer === "object" ? answer : { ok: false, resultado: "indisponivel" };
    } catch {
      return { ok: false, resultado: "indisponivel" };
    }
  }

  // ── States ─────────────────────────────────────────────────────────────
  function status(key: string | null, vars: Record<string, string> = {}) {
    // The site's i18n may finish after this script started: every state change re-syncs the static strings.
    if (i18n()) relabelStatic();
    const el = $("ag-status");
    el.hidden = !key;
    if (key) say(el, key, vars);
    el.classList.toggle("is-error", !!key && key.startsWith("st.") && key !== "st.carregando");
  }
  /** A refusal that ends the flow: the H1 is its one action, the lead explains, at most one button. */
  /** Which panels show: `cal` (info + calendar [+ times]), `form` (info + form), `stop` (info only), `done`. */
  function step(name: "cal" | "form" | "stop" | "done") {
    root.dataset.step = name;
  }
  function stop(key: string) {
    status(null);
    step("stop");
    $("ag-picked").hidden = true;
    const title = $("ag-title");
    const booked = key === "ja_agendado" ? recalled(lastPhone) : null;
    if (booked) {
      // The time this browser booked, plus the one way to reach us.
      say(title, "st.ja_agendado_memo_title", { label: slotLabel(booked, lang()) });
      title.dataset.agSlot = booked;
      say($("ag-lead"), "st.ja_agendado_memo");
      $("ag-wa").hidden = false;
      say($("ag-wa"), "wa");
    } else {
      delete title.dataset.agSlot;
      say(title, `st.${key}_title`);
      say($("ag-lead"), `st.${key}`);
      $("ag-wa").hidden = !WHATSAPP_STATES.has(key);
      say($("ag-wa"), "wa");
    }
    $("ag-grid").hidden = true;
    $("ag-form").hidden = true;
    $("ag-manage").hidden = true;
    title.focus();
  }
  function done(titleKey: string, textKey: string, label = "") {
    status(null);
    step("done");
    $("ag-picked").hidden = true;
    $("ag-grid").hidden = $("ag-form").hidden = $("ag-manage").hidden = true;
    const title = $("ag-done-title");
    say(title, titleKey, { label });
    if (label) title.dataset.agSlot = state.slot;
    say($("ag-done-text"), textKey);
    $("ag-done").hidden = false;
    root.scrollIntoView({ block: "start", behavior: "smooth" });
  }

  // ── Header by mode ─────────────────────────────────────────────────────
  function header(answer: Answer) {
    if (state.modo === "publico") return;
    const icp = answer.icp === "consultorio" ? "consultorio" : "clinica";
    say($("ag-title"), answer.nome ? "priv.title" : "priv.title_anon", { nome: String(answer.nome || "") });
    say($("ag-lead"), `priv.lead_${icp}`);
  }

  // ── Grid ───────────────────────────────────────────────────────────────
  function renderGrid() {
    if (!state.dias.length) return;
    const open = new Map(state.dias.map((d) => [d.dia, d]));
    const months = [...new Set(state.dias.map((d) => d.dia.slice(0, 7)))].sort();
    if (!months.includes(state.mes)) state.mes = (state.dia || state.dias[0].dia).slice(0, 7);
    const at = months.indexOf(state.mes);
    $<HTMLButtonElement>("ag-prev").disabled = at <= 0;
    $<HTMLButtonElement>("ag-next").disabled = at >= months.length - 1;
    $("ag-month").textContent = monthLabel(state.mes, lang());
    $("ag-weekdays").replaceChildren(
      ...weekdayInitials(lang()).map((w) => Object.assign(document.createElement("span"), { textContent: w })),
    );
    // Month grid, Sunday first: blanks, then every day; only the open ones are buttons.
    const [y, m] = state.mes.split("-").map(Number);
    const first = new Date(Date.UTC(y, m - 1, 1)).getUTCDay();
    const total = new Date(Date.UTC(y, m, 0)).getUTCDate();
    const cells: HTMLElement[] = Array.from({ length: first }, () => document.createElement("span"));
    for (let n = 1; n <= total; n++) {
      const dia = `${state.mes}-${String(n).padStart(2, "0")}`;
      if (!open.has(dia)) {
        cells.push(Object.assign(document.createElement("span"), { className: "ag-off", textContent: String(n) }));
        continue;
      }
      const b = document.createElement("button");
      b.type = "button";
      b.className = "ag-day";
      b.textContent = String(n);
      b.setAttribute("aria-label", dayLabel(dia, lang()));
      b.setAttribute("aria-pressed", String(dia === state.dia));
      b.addEventListener("click", () => {
        // Fix 5.3: clicking the chosen day again unselects it (and closes the times panel).
        state.dia = state.dia === dia ? "" : dia;
        renderGrid();
        if (state.dia && window.matchMedia("(max-width: 1023px)").matches)
          $("ag-times").scrollIntoView({ block: "start", behavior: "smooth" });
      });
      cells.push(b);
    }
    $("ag-days").replaceChildren(...cells);
    // Times panel: only once a day is chosen.
    const day = open.get(state.dia);
    $("ag-times").hidden = !day;
    root.classList.toggle("has-times", !!day);
    if (!day) return;
    $("ag-times-title").textContent = dayLabel(day.dia, lang());
    $("ag-slots").replaceChildren(
      ...day.slots.map((s) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "ag-slot";
        b.textContent = hourLabel(s.starts_at, lang());
        b.setAttribute("aria-pressed", String(s.starts_at === state.slot));
        b.addEventListener("click", () => pick(s.starts_at));
        return b;
      }),
    );
  }
  function pick(startsAt: string) {
    state.slot = startsAt;
    const text = $("ag-picked-text");
    say(text, "grid.picked", { label: slotLabel(startsAt, lang()) });
    text.dataset.agSlot = startsAt;
    $("ag-picked").hidden = false;
    // Like Cal.com: the chosen time moves to the info panel and the form takes the calendar's place.
    $("ag-grid").hidden = true;
    $("ag-form").hidden = false;
    step("form");
    ready();
    // Fix 6: the card shrinks when the form replaces the calendar; bring its top back under the navbar
    // instead of scrolling past it.
    root.scrollIntoView({ block: "start", behavior: "smooth" });
  }
  function ready() {
    const consentOk = state.managing || $<HTMLInputElement>("ag-consent").checked;
    $<HTMLButtonElement>("ag-submit").disabled = state.busy || !state.slot || !consentOk;
  }
  async function loadGrid(keepStatus = false) {
    if (!keepStatus) status("st.carregando");
    const answer = await call({ op: "horarios", ...(state.token ? { token: state.token } : {}) });
    if (answer.ok !== true || answer.resultado !== "horarios") return stop(refusalKey(answer)), null;
    state.dias = (answer.dias || []).filter((d: Dia) => d.slots?.length);
    if (!state.dias.length) return stop("vazio"), null;
    if (!state.dias.some((d) => d.dia === state.dia)) state.dia = "";
    state.slot = "";
    $("ag-picked").hidden = true;
    $("ag-form").hidden = true;
    if (!keepStatus) status(null);
    $("ag-grid").hidden = false;
    step("cal");
    renderGrid();
    ready();
    return answer;
  }

  // ── Form mode ──────────────────────────────────────────────────────────
  function formMode() {
    const publico = state.modo === "publico";
    $("ag-public-fields").hidden = !publico;
    $("ag-email-field").hidden = state.managing;
    $("ag-consent-field").hidden = state.managing;
  }
  /** Error tooltip under the field + the field's state: `error` (red), `ok` (green check), or neutral. */
  function fieldError(id: string, key: string | null, ok = false) {
    const el = $(id);
    el.hidden = !key;
    if (key) say(el, key);
    const input = $<HTMLInputElement>(id.replace(/-err$/, ""));
    if (!input) return;
    input.dataset.state = key ? "error" : ok ? "ok" : "";
    if (key) input.setAttribute("aria-invalid", "true");
    else input.removeAttribute("aria-invalid");
  }

  async function submit(event: Event) {
    event.preventDefault();
    if (state.busy || !state.slot) return;
    const body: Answer = { starts_at: state.slot };
    if (state.managing) Object.assign(body, { op: "gerenciar", token: state.token, acao: "remarcar" });
    else {
      Object.assign(body, { op: "agendar", consent_version: root.dataset.consent });
      if (state.token) body.token = state.token;
      const email = $<HTMLInputElement>("ag-email").value.trim();
      fieldError("ag-email-err", validEmail(email) ? null : "form.email_err", !!email);
      let ok = validEmail(email);
      if (email) body.lead_email = email;
      if (state.modo === "publico") {
        const name = $<HTMLInputElement>("ag-name").value.trim();
        const phone = normalizePhone($<HTMLInputElement>("ag-phone").value);
        fieldError("ag-name-err", validName(name) ? null : "form.name_err", validName(name));
        fieldError("ag-phone-err", phone ? null : "form.phone_err", !!phone);
        ok = ok && validName(name) && !!phone;
        Object.assign(body, { lead_name: name, phone });
        lastPhone = phone;
      }
      if (!ok) return;
    }
    state.busy = true;
    const button = $("ag-submit");
    say(button, "form.sending");
    $("ag-erro").hidden = true;
    ready();
    const answer = await call(body);
    state.busy = false;
    say(button, "form.submit");
    ready();
    if (answer.ok === true && ["agendado", "remarcado"].includes(answer.resultado))
      remember(String(answer.starts_at || state.slot), state.modo === "publico" ? lastPhone : null);
    if (answer.ok === true && answer.resultado === "agendado")
      return done("ok.title", "ok.text", slotLabel(answer.starts_at || state.slot, lang()));
    if (answer.ok === true && answer.resultado === "remarcado")
      return done("man.remarcado_title", "man.remarcado_text", slotLabel(answer.starts_at || state.slot, lang()));
    const key = refusalKey(answer);
    if (key === "slot_taken") {
      await loadGrid(true);
      return status("st.slot_taken");
    }
    if (key === "whatsapp_invalido" && state.modo === "publico") return fieldError("ag-phone-err", "st.whatsapp_invalido");
    if (["zapi_indisponivel", "invalido"].includes(key)) {
      const erro = $("ag-erro");
      erro.hidden = false;
      return say(erro, `st.${key}`);
    }
    stop(key);
  }

  // ── Gerenciar ──────────────────────────────────────────────────────────
  function manage(answer: Answer) {
    const atual = answer.atual?.starts_at ? String(answer.atual.starts_at) : "";
    const title = $("ag-manage-title");
    say(title, "man.title", { atual: slotLabel(atual, lang()) });
    title.dataset.agSlot = atual;
    $("ag-manage").hidden = false;
    $("ag-grid").hidden = true;
    step("form");
    $("ag-trocar").addEventListener("click", () => openReschedule());
    $("ag-outro").addEventListener("click", () => openReschedule());
    $("ag-cancelar").addEventListener("click", () => {
      const text = $("ag-confirm-text");
      say(text, "man.confirm", { atual: slotLabel(atual, lang()) });
      text.dataset.agSlot = atual;
      $("ag-confirm").hidden = false;
    });
    $("ag-sim").addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      if (button.disabled) return;
      button.disabled = true;
      const result = await call({ op: "gerenciar", token: state.token, acao: "cancelar" });
      button.disabled = false;
      if (result.ok === true && result.resultado === "cancelado") forget();
      if (result.ok === true && result.resultado === "cancelado") return done("man.cancelado_title", "man.cancelado_text");
      stop(refusalKey(result));
    });
  }
  function openReschedule() {
    $("ag-confirm").hidden = true;
    $("ag-manage").hidden = true;
    $("ag-grid").hidden = false;
    step("cal");
    renderGrid();
  }
  // The manage title uses {atual}; relabel() re-derives it through data-ag-slot, not {label}.
  function fixAtualRelabel() {
    for (const id of ["ag-manage-title", "ag-confirm-text"]) {
      const el = $(id);
      if (el.dataset.agSlot !== undefined) {
        el.dataset.agVars = JSON.stringify({ atual: slotLabel(el.dataset.agSlot, lang()) });
        el.textContent = t(el.dataset.agKey!, { atual: slotLabel(el.dataset.agSlot, lang()) });
      }
    }
  }

  // ── Boot ───────────────────────────────────────────────────────────────
  async function boot() {
    relabel(); // static PT fallback → the language actually applied
    window.addEventListener("site-lang-change", () => { relabel(); fixAtualRelabel(); });
    if (import.meta.env.DEV) {
      const name = new URLSearchParams(location.search).get("fixture");
      if (name) {
        const files = import.meta.glob("../../../tests/agendar/fixtures/*.json", { import: "default" });
        const load = files[`../../../tests/agendar/fixtures/${name}.json`];
        fixture = load ? ((await load()) as Record<string, Answer>) : { horarios: { ok: false, resultado: "indisponivel" } };
        if (fixture.token && !location.hash) history.replaceState(null, "", `${location.pathname}${location.search}#t=${"a".repeat(64)}`);
      }
    }
    const { token, malformed } = parseToken(location.hash);
    if (location.hash) history.replaceState(null, "", `${location.pathname}${location.search}`);
    if (malformed) return stop("link_invalido");
    state.token = token;
    if (!fixture && !root.dataset.endpoint) {
      console.error("[agendar] PUBLIC_AGENDA_ENDPOINT is empty: the page stays closed");
      return stop("desligado");
    }
    $("ag-form").addEventListener("submit", submit);
    $("ag-consent").addEventListener("change", ready);
    // Fix 6.1: filter as the user types (phone mask keeps the caret after the same digit), check on blur.
    const phone = $<HTMLInputElement>("ag-phone");
    phone.addEventListener("input", () => {
      const caret = phone.selectionStart ?? phone.value.length;
      const before = phone.value.slice(0, caret).replace(/\D/g, "").length;
      phone.value = maskPhone(phone.value);
      let pos = 0;
      for (let seen = 0; pos < phone.value.length && seen < before; pos++) if (/\d/.test(phone.value[pos])) seen++;
      phone.setSelectionRange(pos, pos);
      if (normalizePhone(phone.value)) fieldError("ag-phone-err", null, true);
      else if (phone.dataset.state === "ok") fieldError("ag-phone-err", null);
    });
    phone.addEventListener("blur", () => afterPress(() => {
      if (phone.value) fieldError("ag-phone-err", normalizePhone(phone.value) ? null : "form.phone_err", true);
      else fieldError("ag-phone-err", null);
    }));
    const nameEl = $<HTMLInputElement>("ag-name");
    nameEl.addEventListener("input", () => {
      if (validName(nameEl.value)) fieldError("ag-name-err", null, true);
    });
    nameEl.addEventListener("blur", () => afterPress(() => {
      if (nameEl.value) fieldError("ag-name-err", validName(nameEl.value) ? null : "form.name_err", true);
    }));
    const email = $<HTMLInputElement>("ag-email");
    email.addEventListener("input", () => {
      const clean = sanitizeEmail(email.value);
      if (clean !== email.value) email.value = clean;
      if (email.value && validEmail(email.value)) fieldError("ag-email-err", null, true);
      else if (email.dataset.state === "ok") fieldError("ag-email-err", null);
    });
    email.addEventListener("blur", () => afterPress(() =>
      fieldError("ag-email-err", validEmail(email.value) ? null : "form.email_err", !!email.value)));
    const changeTime = () => {
      state.slot = "";
      $("ag-picked").hidden = true;
      $("ag-form").hidden = true;
      $("ag-grid").hidden = false;
      step("cal");
      renderGrid();
      ready();
    };
    $("ag-change").addEventListener("click", changeTime);
    $("ag-picked").addEventListener("click", changeTime);
    const months = (dir: number) => {
      const all = [...new Set(state.dias.map((d) => d.dia.slice(0, 7)))].sort();
      state.mes = all[Math.min(all.length - 1, Math.max(0, all.indexOf(state.mes) + dir))] || state.mes;
      renderGrid();
    };
    $("ag-prev").addEventListener("click", () => months(-1));
    $("ag-next").addEventListener("click", () => months(1));

    const answer = await loadGrid();
    if (!answer) return;
    state.modo = ["agendar", "gerenciar"].includes(answer.modo) && token ? answer.modo : "publico";
    if (token && state.modo === "publico") return stop("link_invalido");
    header(answer);
    if (state.modo === "gerenciar") {
      state.managing = true;
      manage(answer);
    }
    formMode();
    $("ag-form").hidden = !state.slot;
    $("ag-meta").hidden = state.managing;
  }
  boot();
</script>

