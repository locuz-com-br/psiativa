<aside
  id="cookie-consent"
  class="cookie-consent"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-description"
  hidden
>
  <div class="cookie-consent-copy">
    <h2 id="cookie-consent-title">Sua privacidade importa</h2>
    <p id="cookie-consent-description">
      Usamos Google Analytics e Microsoft Clarity para entender o uso do site.
      Eles só serão carregados com sua autorização.
      <a href="/cookies">Saiba mais</a>.
    </p>
  </div>
  <div class="cookie-consent-actions">
    <button type="button" class="cookie-consent-reject" data-consent="denied">
      Rejeitar não essenciais
    </button>
    <button type="button" class="cookie-consent-accept" data-consent="granted">
      Aceitar analíticos
    </button>
  </div>
</aside>

<script is:inline>
  (() => {
    const banner = document.getElementById("cookie-consent");
    if (!banner) return;

    const show = () => {
      banner.hidden = false;
    };
    const hide = () => {
      banner.hidden = true;
    };

    if (!window.psiativaAnalytics?.getConsent()) show();

    banner.querySelectorAll("[data-consent]").forEach((button) => {
      button.addEventListener("click", () => {
        const value = button.getAttribute("data-consent");
        if (value !== "granted" && value !== "denied") return;
        window.psiativaAnalytics?.setConsent(value);
        hide();
      });
    });

    window.addEventListener("psiativa:open-consent", show);
    window.addEventListener("psiativa:consent-change", hide);
  })();
</script>

<style>
  .cookie-consent {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 2000;
    max-width: 680px;
    margin: 0 auto;
    padding: 1.25rem;
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-card);
    background: rgba(250, 255, 255, 0.98);
    box-shadow: 0 18px 50px rgba(7, 17, 19, 0.18);
    backdrop-filter: blur(18px);
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent h2 {
    margin-bottom: 0.4rem;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .cookie-consent p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .cookie-consent a {
    color: var(--primary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-consent-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .cookie-consent-actions button {
    min-height: 44px;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-btn);
    font: 600 0.9rem/1 var(--font-ui);
    cursor: pointer;
  }

  .cookie-consent-reject {
    border: 1px solid var(--color-border-hover);
    background: transparent;
    color: var(--text-heading);
  }

  .cookie-consent-accept {
    border: 1px solid var(--primary);
    background: var(--primary);
    color: #fff;
  }

  @media (max-width: 560px) {
    .cookie-consent-actions {
      flex-direction: column-reverse;
    }

    .cookie-consent-actions button {
      width: 100%;
    }
  }
</style>
