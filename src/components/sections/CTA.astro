---
// CTA Final — Clean centered section (PsiAtiva design system)
import LINKS from "../../constants/links";
---

<section class="cta-final section" id="cta">
  <div class="container">
    <div class="cta-final-content">
      <span class="section-label" data-i18n="cta.label"
        >Pronto para começar?</span
      >
      <h2 class="cta-final-heading">
        <span data-i18n="cta.title_1">Está na hora de </span>
        <em class="text-accent-gold" data-i18n="cta.title_2"
          >revolucionar o atendimento</em
        >
      </h2>
      <div class="cta-final-actions">
        <a href={LINKS.contact.phoneHref} class="btn-primary-dark">
          <span data-i18n="cta.btn">Fale com nossos especialistas</span>
          <span class="icon-circle">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </a>
        <a href={LINKS.contact.meet} class="btn-secondary-light">
          <span data-i18n="cta.btn_secondary">Agende uma demonstração</span>
          <span
            class="icon-circle"
            style="width:40px;height:40px;background:var(--primary);border-radius:100%;display:flex;align-items:center;justify-content:center;"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--accent)"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-final {
    padding: 80px 0;
    background: var(--background);
    border-top: 1px solid var(--color-border);
  }

  .cta-final-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-final-heading {
    font-family: var(--font-family);
    font-weight: 500;
    font-size: 36px;
    line-height: 54px;
    color: var(--text-heading-dark);
  }

  .cta-final-heading em {
    font-style: normal;
    color: var(--accent);
  }

  .cta-final-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1rem;
  }

  @media (max-width: 810px) {
    .cta-final-heading {
      font-size: 28px;
      line-height: 40px;
    }

    .cta-final-actions {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
