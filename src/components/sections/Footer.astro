---
// Footer — Dark teal gradient (PsiAtiva design system)
import { SITE_CONFIG } from "../../config/site.config";
import LINKS from "../../constants/links";

interface Props {
  minimal?: boolean;
  showCookiePreferences?: boolean;
}

const {
  minimal = false,
  showCookiePreferences = false,
} = Astro.props;
const year = new Date().getFullYear();

// Build social links array dynamically — only show non-empty ones
const socialEntries = [
  {
    key: "instagram",
    href: LINKS.socials.instagram,
    label: "Instagram",
    icon: '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
  },
  {
    key: "linkedin",
    href: LINKS.socials.linkedin,
    label: "LinkedIn",
    icon: '<path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    key: "whatsapp",
    href: LINKS.socials.whatsapp,
    label: "WhatsApp",
    icon: '<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>',
  },
  {
    key: "facebook",
    href: LINKS.socials.facebook,
    label: "Facebook",
    icon: '<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>',
  },
  {
    key: "tiktok",
    href: LINKS.socials.tiktok,
    label: "TikTok",
    icon: '<path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"/>',
  },
  {
    key: "youtube",
    href: LINKS.socials.youtube,
    label: "YouTube",
    icon: '<path d="M22.54 6.42a2.78 2.78 0 00-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 00-1.94 2A29 29 0 001 11.75a29 29 0 00.46 5.33A2.78 2.78 0 003.4 19.1c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 001.94-2 29 29 0 00.46-5.25 29 29 0 00-.46-5.43z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>',
  },
  {
    key: "twitter",
    href: LINKS.socials.twitter,
    label: "Twitter / X",
    icon: '<path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/>',
  },
].filter((s) => s.href && s.href.length > 0);
---

<footer class="footer">
  <div class="container">
    <div class={`footer-top ${minimal ? "minimal" : ""}`}>
      <div class="footer-brand">
        <a href={LINKS.pages.home} aria-label={SITE_CONFIG.name}>
          <img
            src={SITE_CONFIG.logos.footerLight}
            alt={SITE_CONFIG.name}
            width="144"
            height="40"
            class="footer-logo"
            loading="lazy"
          />
        </a>
        <p class="footer-tagline" data-i18n="footer.tagline">
          Captação ética e previsível para clínicas de psicologia.
        </p>
      </div>

      {!minimal && (
        <div class="footer-columns">
          <div class="footer-column">
          <h4 class="footer-column-title" data-i18n="footer.col_product">
            Processo
          </h4>
          <ul>
            <li>
              <a
                href={LINKS.sections.funcionalidades}
                data-i18n="footer.link_features">Como Funciona</a>
            </li>
            <li>
              <a href={LINKS.sections.resultados} data-i18n="footer.link_cases"
                >Resultados</a>
            </li>
            <li>
              <a href={LINKS.sections.faq}
                >FAQ</a>
            </li>
          </ul>
        </div>

        <div class="footer-column">
          <h4 class="footer-column-title" data-i18n="footer.col_company">
            PsiAtiva
          </h4>
          <ul>
            <li>
              <a href={LINKS.sections.sobre} data-i18n="footer.link_about"
                >Sobre</a>
            </li>
            <li>
              <a
                href={LINKS.sections.depoimentos}
                data-i18n="footer.link_testimonials">Depoimentos</a>
            </li>
            <li>
              <a href={LINKS.contact.emailHref} data-i18n="footer.link_contact"
                >Contato</a>
            </li>
          </ul>
        </div>

        <div class="footer-column">
          <h4 class="footer-column-title" data-i18n="footer.col_resources">
            Recursos
          </h4>
          <ul>
            <li>
              <a href={LINKS.legal.blog} data-i18n="footer.link_blog">Blog</a>
            </li>
            <li>
              <a href={LINKS.legal.podcast} data-i18n="footer.link_podcast">Podcast</a>
            </li>
            <li>
              <a href={LINKS.legal.terms} data-i18n="footer.link_terms"
                >Termos de Uso</a>
            </li>
            <li>
              <a href={LINKS.legal.privacy} data-i18n="footer.link_privacy"
                >Privacidade</a>
            </li>
            <li>
              <a href={LINKS.legal.cookies}>Cookies</a>
            </li>
          </ul>
        </div>
      </div>
      )}
    </div>

    <div class="footer-bottom">
      <div class="footer-meta">
        <p class="footer-copy">
        © {year}
        {SITE_CONFIG.name}. <span data-i18n="footer.copyright"
          >Todos os direitos reservados.</span>
        </p>
        {
          showCookiePreferences && (
            <button
              type="button"
              class="footer-link-button"
              data-cookie-preferences
            >
              Preferências de cookies
            </button>
          )
        }
      </div>
      {
        socialEntries.length > 0 && (
          <div class="footer-social">
            {socialEntries.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                target="_blank"
                rel="noopener"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={social.icon}
                />
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</footer>

{
  showCookiePreferences && (
    <script is:inline>
      document.querySelectorAll("[data-cookie-preferences]").forEach((button) => {
        button.addEventListener("click", () => {
          window.psiativaAnalytics?.openPreferences();
        });
      });
    </script>
  )
}

<style>
  .footer {
    background: var(--gradient-footer);
    width: 100%;
    padding: 80px 0 40px;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(214, 228, 238, 0.15);
  }

  .footer-top.minimal {
    justify-content: center;
    text-align: center;
  }

  .footer-top.minimal .footer-brand {
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-brand {
    max-width: 280px;
  }

  .footer-logo {
    height: 40px;
    width: auto;
    margin-bottom: 1rem;
  }

  .footer-tagline {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.4;
    color: #ffffff;
  }

  .footer-columns {
    display: flex;
    gap: 4rem;
  }

  .footer-column-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.4;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .footer-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-column a,
  .footer-link-button {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.4;
    color: var(--light-blue);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link-button {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: left;
  }

  .footer-column a:hover,
  .footer-link-button:hover {
    color: #ffffff;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
  }

  .footer-copy {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.4;
    color: var(--light-blue);
    opacity: 0.7;
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .footer-social {
    display: flex;
    gap: 1rem;
  }

  .footer-social a {
    color: var(--light-blue);
    transition: color var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(214, 228, 238, 0.2);
  }

  .footer-social a:hover {
    color: #ffffff;
    border-color: rgba(214, 228, 238, 0.5);
  }

  @media (max-width: 810px) {
    .footer-top {
      flex-direction: column;
      gap: 2.5rem;
    }

    .footer-columns {
      flex-wrap: wrap;
      gap: 2rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
