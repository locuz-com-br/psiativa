---
// Hero section — dark teal gradient with typewriter animation (PsiAtiva)
import { SITE_CONFIG } from "../../config/site.config";
import LINKS from "../../constants/links";

const typewriterWords = SITE_CONFIG.hero.typewriterWords;
---

<section class="hero" id="inicio">
  <!-- Background: CSS gradient (no image) -->
  <div class="hero-background">
    <div class="hero-bg-gradient"></div>
  </div>

  <div class="hero-content container">
    <!-- Tag pills -->
    <div class="tag-container animate-fade-in-up">
      <div class="tag-pill">
        <svg
          class="tag-pill-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"></path>
        </svg>
        <span class="tag-pill-text" data-i18n="hero.tag_1">Psicologia</span>
      </div>
      <div class="tag-pill">
        <svg
          class="tag-pill-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span class="tag-pill-text" data-i18n="hero.tag_2">Captação Ética</span>
      </div>
      <div class="tag-pill">
        <svg
          class="tag-pill-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span class="tag-pill-text" data-i18n="hero.tag_3">Agenda Previsível</span>
      </div>
    </div>

    <!-- Title with typewriter word -->
    <h1 class="hero-title animate-fade-in-up delay-100">
      <span data-i18n="hero.title_1">Ativa sua clínica.</span><br />
      <span data-i18n="hero.title_2">Preserva sua essência.</span>
    </h1>

    <!-- Subtitle -->
    <p
      class="hero-subtitle animate-fade-in-up delay-200"
      data-i18n="hero.subtitle"
    >
      Sua clínica perde pacientes entre o primeiro contato e a sessão confirmada
      — não por falta de competência, mas por falta de processo. A PsiAtiva fecha
      esse buraco de forma ética e estruturada.
    </p>

    <!-- Typewriter word (standalone below subtitle) -->
    <div class="hero-typewriter-line animate-fade-in-up delay-200">
      <span class="hero-typewriter-label">Seu atendimento,</span>
      <span class="hero-typewriter" id="typewriter-word">{typewriterWords[0]}</span>
    </div>

    <!-- CTA Button -->
    <div class="hero-actions animate-fade-in-up delay-300">
      <a href={LINKS.socials.whatsapp} target="_blank" rel="noopener" class="btn-primary-light">
        <span data-i18n="hero.cta_primary">Agendar Diagnóstico Gratuito</span>
        <span class="icon-circle">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    top: -72px;
    width: 100%;
    min-height: 972px;
    overflow: hidden;
    padding-top: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Background */
  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-gradient {
    width: 100%;
    height: 100%;
    background: var(--gradient-hero);
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 60px;
  }

  /* Tag pills */
  .tag-container {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 8px;
  }

  .tag-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 12px;
    height: 32px;
    border-radius: var(--radius-tag);
    background: var(--secondary-40);
    backdrop-filter: blur(10.5px);
    -webkit-backdrop-filter: blur(10.5px);
  }

  .tag-pill-icon {
    color: var(--light-blue);
    flex-shrink: 0;
  }

  .tag-pill-text {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 14px;
    line-height: 16.8px;
    letter-spacing: 0.56px;
    text-transform: uppercase;
    color: var(--light-blue);
  }

  /* Title */
  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 68px;
    line-height: 81.6px;
    letter-spacing: -1.36px;
    color: var(--text-hero-white);
    text-align: center;
    max-width: 900px;
  }

  /* Typewriter line */
  .hero-typewriter-line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1.3;
    color: var(--light-blue);
  }

  .hero-typewriter-label {
    opacity: 0.7;
  }

  .hero-typewriter {
    color: var(--accent);
    border-right: 3px solid var(--accent);
    padding-right: 4px;
    animation: typewriter-cursor 0.8s step-end infinite;
  }

  /* Subtitle */
  .hero-subtitle {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 18px;
    line-height: 28.8px;
    color: var(--text-hero-subtitle);
    text-align: center;
    max-width: 700px;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1rem;
  }

  @media (max-width: 810px) {
    .hero {
      min-height: 700px;
      padding-top: 80px;
    }

    .hero-title {
      font-size: 40px;
      line-height: 48px;
      letter-spacing: -0.8px;
    }

    .hero-subtitle {
      font-size: 16px;
      line-height: 24px;
    }

    .hero-typewriter-line {
      font-size: 22px;
    }

    .tag-pill-text {
      font-size: 12px;
    }
  }
</style>

<script define:vars={{ typewriterWords }}>
  // Typewriter animation
  const el = document.getElementById("typewriter-word");
  if (el && typewriterWords.length > 1) {
    let wordIndex = 0;
    let charIndex = typewriterWords[0].length;
    let isDeleting = true;
    let timer;

    function tick() {
      const currentWord = typewriterWords[wordIndex];

      if (isDeleting) {
        charIndex--;
        el.textContent = currentWord.substring(0, charIndex);
        if (charIndex === 0) {
          isDeleting = false;
          wordIndex = (wordIndex + 1) % typewriterWords.length;
          timer = setTimeout(tick, 300);
          return;
        }
        timer = setTimeout(tick, 50);
      } else {
        const newWord = typewriterWords[wordIndex];
        charIndex++;
        el.textContent = newWord.substring(0, charIndex);
        if (charIndex === newWord.length) {
          isDeleting = true;
          timer = setTimeout(tick, 2500);
          return;
        }
        timer = setTimeout(tick, 80);
      }
    }

    setTimeout(tick, 2000);
  }
</script>
