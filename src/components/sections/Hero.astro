---
// Hero section — dark teal with typewriter animation (PsiAtiva design system)
import { SITE_CONFIG } from "../../config/site.config";
import LINKS from "../../constants/links";

const typewriterWords = SITE_CONFIG.hero.typewriterWords;
---

<section class="hero" id="inicio">
  <!-- Background image -->
  <div class="hero-background">
    <img
      src={SITE_CONFIG.hero.backgroundImage}
      alt=""
      class="hero-bg-img"
      loading="eager"
    />
    <div class="hero-bg-overlay"></div>
  </div>

  <div class="hero-content container">
    <!-- Tag pills -->
    <div class="tag-container animate-fade-in-up">
      <div class="tag-pill">
        <svg
          class="tag-pill-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
          ></path>
        </svg>
        <span class="tag-pill-text" data-i18n="hero.tag_1">Chatbot</span>
      </div>
      <div class="tag-pill">
        <svg
          class="tag-pill-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M12 2a10 10 0 0 1 10 10c0 5.52-4.48 10-10 10S2 17.52 2 12 6.48 2 12 2z"
          ></path>
          <path d="M12 6v6l4 2"></path>
        </svg>
        <span class="tag-pill-text" data-i18n="hero.tag_2"
          >Inteligência Artificial</span
        >
      </div>
      <div class="tag-pill">
        <svg
          class="tag-pill-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
        </svg>
        <span class="tag-pill-text" data-i18n="hero.tag_3">Saúde</span>
      </div>
    </div>

    <!-- Title with typewriter word -->
    <h1 class="hero-title animate-fade-in-up delay-100">
      <span data-i18n="hero.title_1">Cuidado de verdade começa</span><br />
      <span data-i18n="hero.title_2">com um atendimento</span>
      <span class="hero-typewriter" id="typewriter-word"
        >{typewriterWords[0]}</span
      >
    </h1>

    <!-- Subtitle -->
    <p
      class="hero-subtitle animate-fade-in-up delay-200"
      data-i18n="hero.subtitle"
    >
      Automatize o atendimento, reduza filas e ofereça uma experiência
      personalizada para cada paciente — 24 horas por dia.
    </p>

    <!-- CTA Button -->
    <div class="hero-actions animate-fade-in-up delay-300">
      <a href={LINKS.contact.phoneHref} class="btn-primary-light">
        <span data-i18n="hero.cta_primary">Quero Testar Agora</span>
        <span class="icon-circle">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 900px;
    overflow: hidden;
    padding-top: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Background */
  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(47, 67, 77, 0.85) 0%,
      rgba(34, 52, 61, 0.95) 100%
    );
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 60px;
  }

  /* Tag pills */
  .tag-container {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 8px;
  }

  .tag-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 12px;
    height: 32px;
    border-radius: var(--radius-tag);
    background: var(--secondary-40);
    backdrop-filter: blur(10.5px);
    -webkit-backdrop-filter: blur(10.5px);
  }

  .tag-pill-icon {
    color: var(--light-blue);
    flex-shrink: 0;
  }

  .tag-pill-text {
    font-family: var(--font-family);
    font-weight: 600;
    font-size: 14px;
    line-height: 16.8px;
    letter-spacing: 0.56px;
    text-transform: uppercase;
    color: var(--light-blue);
  }

  /* Title */
  .hero-title {
    font-family: var(--font-family);
    font-weight: 600;
    font-size: 68px;
    line-height: 81.6px;
    letter-spacing: -1.36px;
    color: #ffffff;
    text-align: center;
    max-width: 900px;
  }

  .hero-typewriter {
    color: var(--accent);
    border-right: 3px solid var(--accent);
    padding-right: 4px;
    animation: typewriter-cursor 0.8s step-end infinite;
  }

  /* Subtitle */
  .hero-subtitle {
    font-family: var(--font-family);
    font-weight: 500;
    font-size: 18px;
    line-height: 28.8px;
    color: var(--light-blue);
    text-align: center;
    max-width: 700px;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1rem;
  }

  @media (max-width: 810px) {
    .hero {
      min-height: 700px;
      padding-top: 80px;
    }

    .hero-title {
      font-size: 40px;
      line-height: 48px;
      letter-spacing: -0.8px;
    }

    .hero-subtitle {
      font-size: 16px;
      line-height: 24px;
    }

    .tag-pill-text {
      font-size: 12px;
    }
  }
</style>

<script define:vars={{ typewriterWords }}>
  // Typewriter animation
  const el = document.getElementById("typewriter-word");
  if (el && typewriterWords.length > 1) {
    let wordIndex = 0;
    let charIndex = typewriterWords[0].length;
    let isDeleting = true;
    let timer;

    function tick() {
      const currentWord = typewriterWords[wordIndex];

      if (isDeleting) {
        charIndex--;
        el.textContent = currentWord.substring(0, charIndex);
        if (charIndex === 0) {
          isDeleting = false;
          wordIndex = (wordIndex + 1) % typewriterWords.length;
          timer = setTimeout(tick, 300);
          return;
        }
        timer = setTimeout(tick, 50);
      } else {
        const newWord = typewriterWords[wordIndex];
        charIndex++;
        el.textContent = newWord.substring(0, charIndex);
        if (charIndex === newWord.length) {
          isDeleting = true;
          timer = setTimeout(tick, 2500);
          return;
        }
        timer = setTimeout(tick, 80);
      }
    }

    setTimeout(tick, 2000);
  }
</script>
