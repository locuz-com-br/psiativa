---
// Features — 3-column card grid with images (PsiAtiva design system)
// Previously "Services"
import LINKS from "../../constants/links";
---

<section class="features section" id="funcionalidades">
  <div class="container">
    <div class="features-header">
      <span class="section-label" data-i18n="features.label"
        >Funcionalidades</span
      >
      <h2 class="features-title">
        <span data-i18n="features.title_1">O que podemos</span><br />
        <span data-i18n="features.title_2">fazer por você</span>
      </h2>
    </div>

    <div class="features-grid">
      <!-- Card 1 -->
      <div class="feature-card">
        <div class="feature-card-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/>
          </svg>
        </div>
        <div class="feature-card-content">
          <h3 class="feature-card-title" data-i18n="features.f1_title">
            Chatbot <em>inteligente</em> para triagem
          </h3>
          <p class="feature-card-description" data-i18n="features.f1_desc">
            Automatize a triagem inicial e direcione cada paciente para o
            atendimento correto de forma instantânea.
          </p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="feature-card">
        <div class="feature-card-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
        <div class="feature-card-content">
          <h3 class="feature-card-title" data-i18n="features.f2_title">
            Agendamento <em>automatizado</em>
          </h3>
          <p class="feature-card-description" data-i18n="features.f2_desc">
            Seus pacientes agendam consultas a qualquer hora, sem filas e com
            confirmação automática.
          </p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="feature-card">
        <div class="feature-card-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
          </svg>
        </div>
        <div class="feature-card-content">
          <h3 class="feature-card-title" data-i18n="features.f3_title">
            Relatórios em <em>tempo real</em>
          </h3>
          <p class="feature-card-description" data-i18n="features.f3_desc">
            Acompanhe métricas, desempenho e satisfação dos pacientes em
            dashboards intuitivos.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features {
    padding: 0 0 var(--section-padding-lg);
    background: var(--background);
  }

  .features-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 48px;
  }

  .features-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 36px;
    line-height: 46.8px;
    color: var(--text-primary);
  }

  .features-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: center;
  }

  .feature-card {
    width: 390px;
    display: flex;
    flex-direction: column;
  }

  .feature-card-icon {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-card);
    background: rgba(126, 174, 137, 0.12);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .feature-card-content {
    padding: 24px 0 36px;
  }

  .feature-card-title {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 22px;
    line-height: 30.8px;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .feature-card-title em {
    color: var(--accent);
    font-style: normal;
  }

  .feature-card-description {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    line-height: 22.72px;
    color: var(--text-primary);
  }

  @media (max-width: 810px) {
    .features-grid {
      flex-direction: column;
      align-items: center;
    }

    .feature-card {
      width: 100%;
      max-width: 440px;
    }
  }
</style>
