---
// About — Two-column layout (image/video + text + checklist) (PsiAtiva design system)
// Previously "WhyUs"

const VIDEO_ASSETS = {
  webm: 'https://cdn.psiativa.com.br/psiativa.com.br/sections/WhyUs.astro/psiativa.webm',
  mp4: 'https://cdn.psiativa.com.br/psiativa.com.br/sections/WhyUs.astro/psiativa.mp4',
  poster: 'https://cdn.psiativa.com.br/psiativa.com.br/sections/WhyUs.astro/psiativa.webp',
  fallbackJpg: 'https://cdn.psiativa.com.br/psiativa.com.br/sections/WhyUs.astro/psiativa.jpg',
  width: 720,
  height: 1280,
};
---

<section class="about section" id="sobre">
  <div class="container">
    <div class="about-grid">
      <!-- Left: Video / Mockup / Fallback -->
      <div class="about-left">
        <div class="about-image-wrapper" data-video-container>
          {/* Main video element with WebM (VP9 Profile 0) and MP4 (H.264 High L4.0) */}
          <video
            class="about-video"
            muted
            loop
            playsinline
            autoplay
            preload="metadata"
            poster={VIDEO_ASSETS.poster}
            width={VIDEO_ASSETS.width}
            height={VIDEO_ASSETS.height}
            aria-label="Processo de captação para clínicas de psicologia — PsiAtiva"
          >
            <source src={VIDEO_ASSETS.webm} type='video/webm; codecs="vp09.00.40.08"' />
            <source src={VIDEO_ASSETS.mp4} type='video/mp4; codecs="avc1.640028"' />
          </video>

          {/* Picture still for prefers-reduced-motion */}
          <picture class="about-still">
            <source srcset={VIDEO_ASSETS.poster} type="image/webp" />
            <img
              src={VIDEO_ASSETS.fallbackJpg}
              alt="Processo de captação para clínicas de psicologia — PsiAtiva"
              width={VIDEO_ASSETS.width}
              height={VIDEO_ASSETS.height}
              loading="lazy"
              decoding="async"
            />
          </picture>

          {/* Sound toggle button */}
          <button
            type="button"
            class="sound-toggle"
            aria-label="Ativar som do vídeo"
            data-sound-toggle
            title="Ativar som"
          >
            <svg class="icon-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
              <line x1="23" y1="9" x2="17" y2="15"></line>
              <line x1="17" y1="9" x2="23" y2="15"></line>
            </svg>
            <svg class="icon-unmuted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            </svg>
          </button>

          {/* Old placeholder illustration kept as fallback */}
          <div class="about-illustration" aria-hidden="true">
            <svg width="100%" height="100%" viewBox="0 0 400 320" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="400" height="320" rx="16" fill="#F0F7F4"/>
              <rect x="40" y="40" width="200" height="24" rx="12" fill="#7EAE89" opacity="0.3"/>
              <rect x="40" y="80" width="320" height="1" fill="#1A4B51" opacity="0.1"/>
              <circle cx="72" cy="120" r="20" fill="#1A4B51" opacity="0.08"/>
              <rect x="104" y="108" width="160" height="10" rx="5" fill="#1A4B51" opacity="0.12"/>
              <rect x="104" y="126" width="120" height="8" rx="4" fill="#1A4B51" opacity="0.06"/>
              <circle cx="72" cy="176" r="20" fill="#1A4B51" opacity="0.08"/>
              <rect x="104" y="164" width="180" height="10" rx="5" fill="#1A4B51" opacity="0.12"/>
              <rect x="104" y="182" width="140" height="8" rx="4" fill="#1A4B51" opacity="0.06"/>
              <circle cx="72" cy="232" r="20" fill="#1A4B51" opacity="0.08"/>
              <rect x="104" y="220" width="150" height="10" rx="5" fill="#1A4B51" opacity="0.12"/>
              <rect x="104" y="238" width="100" height="8" rx="4" fill="#1A4B51" opacity="0.06"/>
              <rect x="40" y="276" width="140" height="36" rx="18" fill="#1A4B51" opacity="0.9"/>
              <rect x="68" y="288" width="84" height="12" rx="6" fill="#FAFFFF"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- Right: Text content -->
      <div class="about-right">
        <span class="section-label" data-i18n="about.label">Sobre Nós</span>
        <h2 class="about-heading" data-i18n="about.title">
          Você não perde paciente por falta de competência. Perde no caminho entre
          o contato e a sessão.
        </h2>
        <p class="about-body" data-i18n="about.desc">
          Todo mês, alguns pacientes somem entre a primeira mensagem e a sessão
          marcada. Esse trecho entre os dois pontos quase nunca tem dono na
          clínica. A PsiAtiva é a assessoria que cuida dele com método clínico e
          previsibilidade, sem descaracterizar o seu atendimento.
        </p>

        <ul class="about-checklist">
          <li class="about-checklist-item">
            <svg
              class="check-icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
            >
              <circle cx="10" cy="10" r="10" fill="#7EAE89" opacity="0.15"
              ></circle>
              <path
                d="M14 7L8.5 12.5 6 10"
                stroke="#7EAE89"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span data-i18n="about.check_1">Captação estruturada do primeiro contato à confirmação</span>
          </li>
          <li class="about-checklist-item">
            <svg
              class="check-icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
            >
              <circle cx="10" cy="10" r="10" fill="#7EAE89" opacity="0.15"
              ></circle>
              <path
                d="M14 7L8.5 12.5 6 10"
                stroke="#7EAE89"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span data-i18n="about.check_2"
              >Respeito à identidade do seu atendimento</span
            >
          </li>
          <li class="about-checklist-item">
            <svg
              class="check-icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
            >
              <circle cx="10" cy="10" r="10" fill="#7EAE89" opacity="0.15"
              ></circle>
              <path
                d="M14 7L8.5 12.5 6 10"
                stroke="#7EAE89"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span data-i18n="about.check_3"
              >Agenda mais previsível, sem depender só de indicação</span
            >
          </li>
          <li class="about-checklist-item">
            <svg
              class="check-icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
            >
              <circle cx="10" cy="10" r="10" fill="#7EAE89" opacity="0.15"
              ></circle>
              <path
                d="M14 7L8.5 12.5 6 10"
                stroke="#7EAE89"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span data-i18n="about.check_4">Implementação acompanhada de perto, mês a mês</span>
          </li>
        </ul>

        <a href="#funcionalidades" class="btn-primary-dark">
          <span data-i18n="about.cta">Veja como funciona</span>
          <span class="icon-circle">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: var(--section-padding-lg) 0;
    background: var(--background);
  }

  .about-grid {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  /* Left column */
  .about-left {
    flex: 1;
    max-width: 592px;
    display: flex;
    justify-content: center;
  }

  .about-image-wrapper {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: linear-gradient(
      135deg,
      var(--light-blue) 0%,
      var(--background-subtle) 100%
    );
    aspect-ratio: 9/16;
    max-width: 360px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 16px 40px -12px rgba(26, 75, 81, 0.16);
    border: 1px solid rgba(126, 174, 137, 0.25);
  }

  .about-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-still {
    display: none;
    width: 100%;
    height: 100%;
  }

  .about-still img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Sound toggle button */
  .sound-toggle {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(26, 75, 81, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #FAFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 10;
  }

  .sound-toggle:hover {
    background: rgba(26, 75, 81, 0.95);
    transform: scale(1.08);
  }

  .sound-toggle .icon-unmuted {
    display: none;
  }

  .sound-toggle.is-unmuted .icon-unmuted {
    display: block;
  }

  .sound-toggle.is-unmuted .icon-muted {
    display: none;
  }

  /* Fallback illustration: hidden unless container has-error */
  .about-illustration {
    display: none;
    width: 100%;
    height: 100%;
  }

  .about-image-wrapper.has-error {
    aspect-ratio: 4/3;
    max-width: 592px;
  }

  .about-image-wrapper.has-error .about-video,
  .about-image-wrapper.has-error .about-still,
  .about-image-wrapper.has-error .sound-toggle {
    display: none !important;
  }

  .about-image-wrapper.has-error .about-illustration {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .about-video {
      display: none;
    }
    .about-still {
      display: block;
    }
    .sound-toggle {
      display: none;
    }
  }

  .about-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Right column */
  .about-right {
    flex: 1;
    max-width: 444px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about-heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 36px;
    line-height: 46.8px;
    color: var(--text-primary);
  }

  .about-body {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    color: var(--text-primary);
  }

  /* Checklist */
  .about-checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .about-checklist-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    line-height: 22.72px;
    color: var(--text-primary);
  }

  .check-icon {
    flex-shrink: 0;
  }

  @media (max-width: 810px) {
    .about-grid {
      flex-direction: column;
      gap: 32px;
    }

    .about-left {
      max-width: 100%;
    }

    .about-right {
      max-width: 100%;
    }

    .about-heading {
      font-size: 28px;
      line-height: 36.4px;
    }
  }
</style>

<script>
  (() => {
    const container = document.querySelector('[data-video-container]');
    if (!container) return;

    const video = container.querySelector<HTMLVideoElement>('.about-video');
    const soundBtn = container.querySelector<HTMLButtonElement>('[data-sound-toggle]');

    if (video) {
      video.addEventListener('error', () => {
        container.classList.add('has-error');
      });

      if (soundBtn) {
        soundBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          video.muted = !video.muted;
          soundBtn.classList.toggle('is-unmuted', !video.muted);
          const label = video.muted ? 'Ativar som do vídeo' : 'Desativar som do vídeo';
          soundBtn.setAttribute('aria-label', label);
          soundBtn.setAttribute('title', label);
        });
      }
    }
  })();
</script>

