---
// About — Two-column layout (image + text + checklist) (PsiAtiva design system)
// Previously "WhyUs"
---

<section class="about section" id="sobre">
  <div class="container">
    <div class="about-grid">
      <!-- Left: Image/Mockup -->
      <div class="about-left">
        <div class="about-image-wrapper">
          <div class="about-illustration">
            <svg width="100%" height="100%" viewBox="0 0 400 320" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="400" height="320" rx="16" fill="#F0F7F4"/>
              <rect x="40" y="40" width="200" height="24" rx="12" fill="#7EAE89" opacity="0.3"/>
              <rect x="40" y="80" width="320" height="1" fill="#1A4B51" opacity="0.1"/>
              <circle cx="72" cy="120" r="20" fill="#1A4B51" opacity="0.08"/>
              <rect x="104" y="108" width="160" height="10" rx="5" fill="#1A4B51" opacity="0.12"/>
              <rect x="104" y="126" width="120" height="8" rx="4" fill="#1A4B51" opacity="0.06"/>
              <circle cx="72" cy="176" r="20" fill="#1A4B51" opacity="0.08"/>
              <rect x="104" y="164" width="180" height="10" rx="5" fill="#1A4B51" opacity="0.12"/>
              <rect x="104" y="182" width="140" height="8" rx="4" fill="#1A4B51" opacity="0.06"/>
              <circle cx="72" cy="232" r="20" fill="#1A4B51" opacity="0.08"/>
              <rect x="104" y="220" width="150" height="10" rx="5" fill="#1A4B51" opacity="0.12"/>
              <rect x="104" y="238" width="100" height="8" rx="4" fill="#1A4B51" opacity="0.06"/>
              <rect x="40" y="276" width="140" height="36" rx="18" fill="#1A4B51" opacity="0.9"/>
              <rect x="68" y="288" width="84" height="12" rx="6" fill="#FAFFFF"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- Right: Text content -->
      <div class="about-right">
        <span class="section-label" data-i18n="about.label">Sobre Nós</span>
        <h2 class="about-heading" data-i18n="about.title">
          A plataforma que transforma o atendimento
        </h2>
        <p class="about-body" data-i18n="about.desc">
          Combinamos inteligência artificial e automação para criar experiências
          de atendimento que realmente importam — mais rápidas, mais humanas e
          escaláveis.
        </p>

        <ul class="about-checklist">
          <li class="about-checklist-item">
            <svg
              class="check-icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
            >
              <circle cx="10" cy="10" r="10" fill="#7EAE89" opacity="0.15"
              ></circle>
              <path
                d="M14 7L8.5 12.5 6 10"
                stroke="#7EAE89"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span data-i18n="about.check_1">Atendimento automatizado 24/7</span>
          </li>
          <li class="about-checklist-item">
            <svg
              class="check-icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
            >
              <circle cx="10" cy="10" r="10" fill="#7EAE89" opacity="0.15"
              ></circle>
              <path
                d="M14 7L8.5 12.5 6 10"
                stroke="#7EAE89"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span data-i18n="about.check_2"
              >Integração com sistemas existentes</span
            >
          </li>
          <li class="about-checklist-item">
            <svg
              class="check-icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
            >
              <circle cx="10" cy="10" r="10" fill="#7EAE89" opacity="0.15"
              ></circle>
              <path
                d="M14 7L8.5 12.5 6 10"
                stroke="#7EAE89"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span data-i18n="about.check_3"
              >Dashboard de métricas em tempo real</span
            >
          </li>
          <li class="about-checklist-item">
            <svg
              class="check-icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
            >
              <circle cx="10" cy="10" r="10" fill="#7EAE89" opacity="0.15"
              ></circle>
              <path
                d="M14 7L8.5 12.5 6 10"
                stroke="#7EAE89"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span data-i18n="about.check_4">Personalização por paciente</span>
          </li>
        </ul>

        <a href="#funcionalidades" class="btn-primary-dark">
          <span data-i18n="about.cta">Conheça nossas soluções</span>
          <span class="icon-circle">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: var(--section-padding-lg) 0;
    background: var(--background);
  }

  .about-grid {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  /* Left column */
  .about-left {
    flex: 1;
    max-width: 592px;
  }

  .about-image-wrapper {
    border-radius: var(--radius-card);
    overflow: hidden;
    background: linear-gradient(
      135deg,
      var(--light-blue) 0%,
      var(--background-subtle) 100%
    );
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Right column */
  .about-right {
    flex: 1;
    max-width: 444px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about-heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 36px;
    line-height: 46.8px;
    color: var(--text-primary);
  }

  .about-body {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    color: var(--text-primary);
  }

  /* Checklist */
  .about-checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .about-checklist-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    line-height: 22.72px;
    color: var(--text-primary);
  }

  .check-icon {
    flex-shrink: 0;
  }

  @media (max-width: 810px) {
    .about-grid {
      flex-direction: column;
      gap: 32px;
    }

    .about-left {
      max-width: 100%;
    }

    .about-right {
      max-width: 100%;
    }

    .about-heading {
      font-size: 28px;
      line-height: 36.4px;
    }
  }
</style>
