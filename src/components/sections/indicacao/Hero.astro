---
// Indicação Hero — dark teal gradient with hemorrhage-style headline (PsiAtiva)
import { SITE_CONFIG } from "../../../config/site.config";

const whatsappLink = `https://wa.me/${SITE_CONFIG.contact.whatsappNumber}?text=${encodeURIComponent("Olá! Vim por uma indicação e gostaria de agendar o diagnóstico gratuito.")}`;
---

<section class="hero" id="inicio">
  <div class="hero-background">
    <div class="hero-bg-gradient"></div>
  </div>

  <div class="hero-content container">
    <!-- Tag pills -->
    <div class="tag-container animate-fade-in-up">
      <div class="tag-pill">
        <svg
          class="tag-pill-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 11l-3-3m0 0l-3 3m3-3v8"></path>
        </svg>
        <span class="tag-pill-text" data-i18n="indicacao.hero.tag">Página de Indicação</span>
      </div>
    </div>

    <!-- Title -->
    <h1 class="hero-title animate-fade-in-up delay-100">
      <span data-i18n="indicacao.hero.title_1">Você está perdendo pacientes</span><br />
      <span data-i18n="indicacao.hero.title_2">entre o primeiro contato e a sessão confirmada.</span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-subtitle animate-fade-in-up delay-200" data-i18n="indicacao.hero.subtitle">
      O buraco está no processo entre esses dois momentos.
    </p>

    <p class="hero-body animate-fade-in-up delay-200">
      <span data-i18n="indicacao.hero.body1_pre">A PsiAtiva é a </span><strong data-i18n="indicacao.hero.body1_strong">assessoria de captação ética</strong><span data-i18n="indicacao.hero.body1_post"> especializada em psicologia clínica. A maioria das clínicas só percebe esse buraco quando o mês vira.</span>
    </p>

    <p class="hero-body animate-fade-in-up delay-200">
      <span data-i18n="indicacao.hero.body2_pre">A gente fecha o caminho que vai de quem te procura até o paciente sentado na sua sala. Esse caminho tem nome: </span><em data-i18n="indicacao.hero.body2_gap">GAP, o Gerador de Agenda Previsível</em>.
    </p>

    <!-- CTA -->
    <div class="hero-actions animate-fade-in-up delay-300">
      <a href={whatsappLink} target="_blank" rel="noopener" class="btn-primary-light">
        <span data-i18n="indicacao.hero.cta">AGENDAR DIAGNÓSTICO</span>
        <span class="icon-circle">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    top: -72px;
    width: 100%;
    min-height: 820px;
    overflow: hidden;
    padding-top: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-gradient {
    width: 100%;
    height: 100%;
    background: var(--gradient-hero);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: 60px;
    max-width: 880px;
  }

  .tag-container {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 8px;
  }

  .tag-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 12px;
    height: 32px;
    border-radius: var(--radius-tag);
    background: var(--secondary-40);
    backdrop-filter: blur(10.5px);
    -webkit-backdrop-filter: blur(10.5px);
  }

  .tag-pill-icon {
    color: var(--light-blue);
    flex-shrink: 0;
  }

  .tag-pill-text {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 14px;
    line-height: 16.8px;
    letter-spacing: 0.56px;
    text-transform: uppercase;
    color: var(--light-blue);
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 56px;
    line-height: 1.15;
    letter-spacing: -1.12px;
    color: var(--text-hero-white);
    text-align: center;
    max-width: 880px;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-weight: 600;
    font-style: italic;
    font-size: 22px;
    line-height: 1.5;
    color: var(--accent);
    margin-top: 4px;
  }

  .hero-body {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 17px;
    line-height: 28px;
    color: var(--text-hero-subtitle);
    text-align: center;
    max-width: 720px;
  }

  .hero-body strong {
    color: var(--light-blue);
    font-weight: 600;
  }

  .hero-body em {
    color: var(--accent);
    font-style: normal;
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1rem;
  }

  @media (max-width: 810px) {
    .hero {
      min-height: 700px;
      padding-top: 80px;
    }

    .hero-title {
      font-size: 34px;
      line-height: 42px;
      letter-spacing: -0.6px;
    }

    .hero-subtitle {
      font-size: 18px;
    }

    .hero-body {
      font-size: 15px;
      line-height: 24px;
    }

    .tag-pill-text {
      font-size: 12px;
    }
  }
</style>
