---
// Next Step — CTA with WhatsApp pré-preenchido (PsiAtiva)
import { SITE_CONFIG } from "../../../config/site.config";

const whatsappLink = `https://wa.me/${SITE_CONFIG.contact.whatsappNumber}?text=${encodeURIComponent("Olá! Vim por uma indicação e gostaria de agendar o diagnóstico gratuito.")}`;
---

<section class="next-step section" id="proximo-passo">
  <div class="container">
    <div class="next-step-content">
      <span class="section-label">Próximo passo</span>
      <h2 class="next-step-heading">
        O primeiro passo é uma conversa de <strong>20 minutos</strong>, sem compromisso.
      </h2>
      <p class="next-step-body">
        A ideia é entender o seu cenário e ver se faz sentido seguir.
        Se não fizer, a gente diz na própria conversa.
      </p>

      <div class="next-step-actions">
        <a href={whatsappLink} target="_blank" rel="noopener" class="btn-primary-dark">
          <span>Diagnóstico gratuito pelo WhatsApp</span>
          <span class="icon-circle">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </a>
      </div>

      <p class="next-step-fineprint">
        Mensagem pré-preenchida — basta enviar pelo seu WhatsApp.
      </p>
    </div>
  </div>
</section>

<style>
  .next-step {
    padding: var(--section-padding-md) 0;
    background: var(--background-subtle);
  }

  .next-step-content {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .next-step-heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 32px;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .next-step-body {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-primary);
    max-width: 620px;
  }

  .next-step-heading strong {
    color: var(--accent);
    font-weight: 600;
    font-style: italic;
  }

  .next-step-actions {
    margin-top: 12px;
  }

  .next-step-fineprint {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-top: 8px;
  }

  @media (max-width: 720px) {
    .next-step-heading {
      font-size: 24px;
    }

    .next-step-body {
      font-size: 15.5px;
    }
  }
</style>
