---
// Who Is PsiAtiva — short bio block (PsiAtiva)
import { SITE_CONFIG } from "../../../config/site.config";
---

<section class="who section" id="quem-somos">
  <div class="container">
    <div class="who-content">
      <span class="section-label">Quem é a PsiAtiva</span>
      <p class="who-body">
        PsiAtiva é uma <strong>assessoria de captação focada exclusivamente em psicologia</strong>.
        Trabalhamos com clínicas e psicólogas autônomas que querem agenda previsível
        sem abrir mão da identidade clínica.
      </p>
      <p class="who-tagline">
        {SITE_CONFIG.tagline.pt}
      </p>
    </div>
  </div>
</section>

<style>
  .who {
    padding: var(--section-padding-sm) 0;
    background: var(--background);
  }

  .who-content {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .who-body {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-primary);
  }

  .who-body strong {
    color: var(--primary);
    font-weight: 600;
  }

  .who-tagline {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: 22px;
    line-height: 1.4;
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .who-body {
      font-size: 16px;
    }

    .who-tagline {
      font-size: 18px;
    }
  }
</style>
