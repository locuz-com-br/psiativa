---
// Button — Pill button component (PsiAtiva design system)

interface Props {
  href?: string;
  variant?:
    | "primary-light"
    | "primary-dark"
    | "secondary-light"
    | "nav-cta"
    | "footer-cta";
  class?: string;
  text: string;
  showIcon?: boolean;
}

const {
  href = "#",
  variant = "primary-dark",
  class: className,
  text,
  showIcon = true,
} = Astro.props;
---

<a href={href} class={`btn-${variant} ${className || ""}`}>
  <span>{text}</span>
  {
    showIcon && (
      <span class="icon-circle">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </span>
    )
  }
</a>
