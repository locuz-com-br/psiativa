---
import { SITE_CONFIG } from '../config/site.config';

interface Props {
  title: string;
  description?: string;
  hideNavAndFooter?: boolean;
}

const {
  title,
  description = SITE_CONFIG.description.pt,
  hideNavAndFooter = false
} = Astro.props;

const siteName = SITE_CONFIG.name;

import '../styles/global.css';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import WhatsAppFab from '../components/sections/WhatsAppFab.astro';
---

<!doctype html>
<html lang={SITE_CONFIG.defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- OG / Social -->
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE_CONFIG.defaultLocale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />

    <!-- Theme -->
    <meta name="theme-color" content="#1A4B51" />

    <title>{title} | {siteName}</title>
    <link rel="icon" type="image/svg+xml" href={SITE_CONFIG.logos.favicon} />

    <!-- Preload critical fonts: New York + Lora -->
    <link rel="preload" href="/fonts/new-york/NewYorkLarge-Semibold.otf" as="font" type="font/opentype" crossorigin />
    <link rel="preload" href="/fonts/lora/lora-regular.ttf" as="font" type="font/truetype" crossorigin />

    <!-- Google Fonts: Source Serif 4 (UI / buttons) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />

    <!-- Prevent FOUC: apply saved theme before paint (preserved for future use) -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('site-theme');
        if (saved === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    {!hideNavAndFooter && <Navbar />}
    <main>
      <slot />
    </main>
    {!hideNavAndFooter && <Footer />}
    {SITE_CONFIG.sections.whatsappFab && <WhatsAppFab />}
    <script src="../scripts/i18n.ts"></script>
  </body>
</html>
