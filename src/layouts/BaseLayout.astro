---
import { SITE_CONFIG } from '../config/site.config';
import SEOHead from '../components/seo/SEOHead.astro';
import Analytics from '../components/analytics/Analytics.astro';
import CookieConsent from '../components/analytics/CookieConsent.astro';
import ClickBeacon from '../components/analytics/ClickBeacon.astro';
import MetaPixel from '../components/analytics/MetaPixel.astro';

interface NavItem {
  href: string;
  key: string;
  label: string;
}

interface Props {
  title: string;
  description?: string;
  /** Optional i18n keys so <title>/description localize on the language toggle. */
  titleKey?: string;
  descriptionKey?: string;
  hideNavAndFooter?: boolean;
  hideWhatsAppFab?: boolean;
  canonicalPath?: string;
  ogType?: "website" | "article";
  image?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  /** Override the navbar links/CTA/logo for this page (defaults to the home set). */
  navbar?: {
    items?: NavItem[];
    cta?: NavItem;
    logoHref?: string;
  };
  footerType?: "default" | "minimal";
}

const {
  title,
  description = SITE_CONFIG.description.pt,
  titleKey,
  descriptionKey,
  hideNavAndFooter = false,
  hideWhatsAppFab = hideNavAndFooter,
  canonicalPath,
  ogType = "website",
  image,
  schema,
  noindex = false,
  navbar,
  footerType = "default",
} = Astro.props;

const hasAnalytics = Boolean(
  SITE_CONFIG.analytics.googleAnalyticsId ||
  SITE_CONFIG.analytics.clarityId
);

import '../styles/global.css';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import WhatsAppFab from '../components/sections/WhatsAppFab.astro';
---

<!doctype html>
<html lang={SITE_CONFIG.defaultLocale}>
  <head>
    <!-- Google Tag Manager -->
    {
      SITE_CONFIG.analytics.gtmId && (
        <script
          is:inline
          set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${SITE_CONFIG.analytics.gtmId}');`}
        />
      )
    }
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEOHead
      title={title}
      description={description}
      titleKey={titleKey}
      descriptionKey={descriptionKey}
      canonicalPath={canonicalPath}
      type={ogType}
      image={image}
      schema={schema}
      noindex={noindex}
    />

    <!-- Theme -->
    <meta name="theme-color" content="#1A4B51" />
    <link rel="icon" type="image/svg+xml" href={SITE_CONFIG.logos.favicon} />

    <!-- Preload critical fonts: New York + Lora -->
    <link rel="preload" href="/fonts/new-york/NewYorkLarge-Semibold.otf" as="font" type="font/opentype" crossorigin />
    <link rel="preload" href="/fonts/lora/lora-regular.ttf" as="font" type="font/truetype" crossorigin />

    <!-- Google Fonts: Source Serif 4 (UI / buttons) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />

    <!-- Prevent FOUC: apply saved theme before paint (preserved for future use) -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('site-theme');
        if (saved === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    {
      hasAnalytics && (
        <Analytics
          googleAnalyticsId={SITE_CONFIG.analytics.googleAnalyticsId}
          clarityId={SITE_CONFIG.analytics.clarityId}
        />
      )
    }
    {/*
      Rendered UNCONDITIONALLY and outside `hasAnalytics` on purpose: this counts
      WhatsApp CTA clicks with no cookie and no identifier, so it must keep working
      when the visitor declines analytics consent. Gating it would make its count a
      fraction of reality and destroy the comparison against db_sales.sessions.
    */}
    <ClickBeacon
      endpoint={SITE_CONFIG.analytics.beaconEndpoint}
      siteId={SITE_CONFIG.analytics.beaconSiteId}
    />
    {/*
      Consent-GATED, unlike ClickBeacon: the Pixel sets _fbp/_fbc and builds ad
      audiences, so it is personal data and fbevents.js is not fetched until the
      visitor accepts.
    */}
    <MetaPixel
      pixelIds={SITE_CONFIG.analytics.metaPixelIds}
      capiEndpoint={SITE_CONFIG.analytics.metaCapiEndpoint}
    />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    {
      SITE_CONFIG.analytics.gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${SITE_CONFIG.analytics.gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <!-- End Google Tag Manager (noscript) -->
    {!hideNavAndFooter && <Navbar items={navbar?.items} cta={navbar?.cta} logoHref={navbar?.logoHref} />}
    <main>
      <slot />
    </main>
    {!hideNavAndFooter && (
      <Footer
        minimal={footerType === "minimal"}
        showCookiePreferences={hasAnalytics}
      />
    )}
    {SITE_CONFIG.sections.whatsappFab && !hideWhatsAppFab && <WhatsAppFab />}
    {hasAnalytics && <CookieConsent />}
    <script src="../scripts/i18n.ts"></script>
  </body>
</html>
