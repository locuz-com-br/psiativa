---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ParticleField from "../../components/ui/ParticleField.astro";
import { articleSchema, breadcrumbSchema, faqPageSchema } from "../../lib/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const postPath = `/blog/${post.id}/`;
const published = post.data.publishedAt.toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

const schemas = [
  articleSchema({
    title: post.data.title,
    description: post.data.description,
    path: postPath,
    publishedAt: post.data.publishedAt,
    updatedAt: post.data.updatedAt,
    reviewedBy: post.data.reviewedBy,
  }),
  breadcrumbSchema([
    { name: "Início", path: "/" },
    { name: "Blog", path: "/blog/" },
    { name: post.data.title, path: postPath },
  ]),
  ...(post.data.faqs.length > 0 ? [faqPageSchema(post.data.faqs)] : []),
];
---

<BaseLayout
  title={post.data.seoTitle}
  description={post.data.description}
  canonicalPath={postPath}
  ogType="article"
  schema={schemas}
>
  <article class="blog-post">
    <header class="post-header">
      <!-- Same look as the home hero: teal gradient + particle field -->
      <div class="post-header-bg">
        <div class="post-header-gradient"></div>
        <ParticleField count={120} opacity={0.45} />
      </div>
      <div class="container post-header-inner">
        <a class="back-link" href="/blog/">Blog PsiAtiva</a>
        <div class="post-meta">
          <span class="tag-pill">{post.data.icp}</span>
          <span class="tag-pill">{post.data.cluster}</span>
          <span class="tag-pill">{published}</span>
        </div>
        <h1 class="post-title">{post.data.h1 ?? post.data.title}</h1>
      </div>
    </header>

    <div class="container post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    background: var(--background);
  }

  .post-header {
    position: relative;
    overflow: hidden;
    /* Tuck under the floating nav like the home hero (its top: -72px) */
    margin-top: -72px;
    padding: calc(9rem + 72px) 0 4.5rem;
    text-align: center;
  }

  .post-header-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .post-header-gradient {
    width: 100%;
    height: 100%;
    background: var(--gradient-hero);
  }

  .post-header-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .back-link {
    display: inline-flex;
    color: var(--light-blue);
    font-family: var(--font-ui);
    font-weight: 700;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  /* Same pill as the home hero's tags */
  .tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    min-height: 32px;
    border-radius: var(--radius-tag);
    background: var(--secondary-40);
    backdrop-filter: blur(10.5px);
    -webkit-backdrop-filter: blur(10.5px);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.56px;
    text-transform: uppercase;
    color: var(--light-blue);
  }

  .post-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-hero-white);
    margin: 0;
  }

  .post-body {
    max-width: 820px;
    padding-top: 3rem;
    padding-bottom: 6rem;
  }

  :global(.post-body h1) {
    margin-bottom: 1.25rem;
    color: var(--text-heading);
    font-size: clamp(2.35rem, 6vw, 4rem);
    line-height: 1.12;
    letter-spacing: 0;
  }

  :global(.post-body h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--text-heading);
    font-size: clamp(1.8rem, 4vw, 2.35rem);
    line-height: 1.2;
    letter-spacing: 0;
  }

  :global(.post-body h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text-heading-dark);
    font-size: 1.35rem;
    letter-spacing: 0;
  }

  :global(.post-body p),
  :global(.post-body li) {
    color: var(--text-secondary);
    font-size: 1.06rem;
    line-height: 1.78;
  }

  :global(.post-body p) {
    margin-bottom: 1.25rem;
  }

  :global(.post-body ul),
  :global(.post-body ol) {
    margin: 0 0 1.5rem 1.25rem;
  }

  :global(.post-body li) {
    margin-bottom: 0.65rem;
  }

  :global(.post-body blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--accent);
    background: var(--background-subtle);
  }

  :global(.post-body blockquote p) {
    margin: 0;
    color: var(--text-heading);
    font-weight: 700;
  }

  :global(.post-body a) {
    color: var(--secondary);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  :global(.post-body hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--color-border);
  }
</style>
