---
import { SITE_CONFIG } from '../config/site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import LogoBar from '../components/sections/LogoBar.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import Services from '../components/sections/Services.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Process from '../components/sections/Process.astro';
import Results from '../components/sections/Results.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTA from '../components/sections/CTA.astro';
import CalcCTA from '../components/sections/CalcCTA.astro';
import QuizCTA from '../components/sections/QuizCTA.astro';
import AuditSiteCTA from '../components/sections/AuditSiteCTA.astro';
import Contact from '../components/sections/Contact.astro';
import faqData from '../data/faq.json';
import translations from '../data/translations.json';
import { faqPageSchema, organizationSchema, websiteSchema } from '../lib/schema';

const s = SITE_CONFIG.sections;

// Sequence lives in `site.config.ts` (`homeOrder`); this map only says which
// component each key renders. Adding a section = one entry here + one entry
// there. Keys not listed in `homeOrder` simply never render.
const SECTIONS = {
  hero: Hero,
  partners: LogoBar,
  about: WhyUs,
  features: Services,
  calcCta: CalcCTA,
  functionalities: Process,
  quizCta: QuizCTA,
  cases: Results,
  auditSiteCta: AuditSiteCTA,
  testimonials: Testimonials,
  faq: FAQ,
  ctaFinal: CTA,
  contact: Contact,
} as const;

function getTranslation(path: string) {
  return path.split('.').reduce((acc, key) => acc?.[key], translations as any)?.pt ?? '';
}

const homeFaqs = faqData.items.map((item) => ({
  question: getTranslation(item.translationPrefix),
  answer: getTranslation(item.answerPrefix),
}));

const homeSchema = [
  organizationSchema(),
  websiteSchema(),
  faqPageSchema(homeFaqs),
];
---

<BaseLayout
  title="Captação ética para clínicas de psicologia"
  description={SITE_CONFIG.description.pt}
  canonicalPath="/"
  schema={homeSchema}
>
  {
    SITE_CONFIG.homeOrder.map((key) => {
      const Section = SECTIONS[key];
      return s[key] && Section ? <Section /> : null;
    })
  }
</BaseLayout>
