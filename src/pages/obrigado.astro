---
import BaseLayout from "../layouts/BaseLayout.astro";
import LINKS from "../constants/links";
---

<BaseLayout
  title="Obrigado"
  description="Recebemos suas informações. A equipe PsiAtiva dará continuidade ao seu atendimento."
  canonicalPath="/obrigado"
  noindex={true}
>
  <section class="thank-you-section">
    <div class="container">
      <div class="thank-you-card">
        <span class="thank-you-icon" aria-hidden="true">
          <svg
            width="44"
            height="44"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </span>

        <span class="section-label">Informações recebidas</span>
        <h1>Obrigado pelo seu interesse</h1>
        <p>
          Suas respostas foram registradas. A equipe PsiAtiva analisará as
          informações e, quando fizer sentido para o seu momento, dará
          continuidade ao contato.
        </p>

        <div class="thank-you-note">
          <h2>Quer falar com a gente agora?</h2>
          <p>
            Você também pode chamar a equipe pelo WhatsApp para tirar dúvidas
            sobre o processo de diagnóstico.
          </p>
        </div>

        <div class="thank-you-actions">
          <a
            href={LINKS.socials.whatsapp}
            target="_blank"
            rel="noopener"
            class="btn btn-primary"
            data-analytics-location="obrigado"
          >
            Falar com a PsiAtiva
          </a>
          <a
            href={LINKS.pages.home}
            class="btn btn-outline"
            data-analytics-event="cta_click"
            data-analytics-location="obrigado"
            data-analytics-destination="home"
          >
            Voltar ao início
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thank-you-section {
    min-height: 76vh;
    display: grid;
    place-items: center;
    padding: clamp(7rem, 12vw, 10rem) 0;
    background:
      radial-gradient(circle at top, rgba(126, 174, 137, 0.2), transparent 42%),
      var(--background);
  }

  .thank-you-card {
    width: min(100%, 680px);
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    background: rgba(250, 255, 255, 0.96);
    box-shadow: 0 24px 70px rgba(26, 75, 81, 0.11);
    text-align: center;
  }

  .thank-you-icon {
    display: inline-grid;
    width: 80px;
    height: 80px;
    margin-bottom: 1.5rem;
    place-items: center;
    border-radius: 50%;
    background: var(--gradient-brand);
    color: #fff;
  }

  .thank-you-card .section-label {
    display: block;
    margin-bottom: 0.75rem;
  }

  .thank-you-card h1 {
    margin-bottom: 1rem;
    font-size: clamp(2.25rem, 7vw, 4rem);
    line-height: 1.08;
  }

  .thank-you-card > p {
    max-width: 560px;
    margin: 0 auto;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .thank-you-note {
    margin-top: 2rem;
    padding: 1.5rem;
    border-radius: var(--radius-card);
    background: var(--background-subtle);
    text-align: left;
  }

  .thank-you-note h2 {
    margin-bottom: 0.5rem;
    font-size: 1.35rem;
  }

  .thank-you-note p {
    color: var(--text-secondary);
  }

  .thank-you-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
