---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PODCAST } from "../../config/podcast.config";
import { podcastSeriesSchema, breadcrumbSchema } from "../../lib/schema";

const episodes = (await getCollection("podcast")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const [featured, ...rest] = episodes;

const fmtDate = (d: Date) =>
  d.toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric", timeZone: "UTC" });

const schemas = [
  podcastSeriesSchema({
    name: PODCAST.name,
    description: PODCAST.description,
    path: PODCAST.basePath,
    rss: PODCAST.rss,
    image: PODCAST.cover,
    // Programa PESSOAL da host, republicado aqui. Sem `worksForPsiAtiva`:
    // ela e parceira externa, nao quadro da PsiAtiva.
    author: {
      name: PODCAST.host.name,
      crp: PODCAST.host.crp,
      url: PODCAST.host.linkedin,
      sameAs: [PODCAST.host.instagram, PODCAST.host.linkedin, PODCAST.host.lattes],
    },
    // Ancora a serie no programa real (Apple/Spotify), separando-a da Organization.
    sameAs: [PODCAST.apple, PODCAST.spotifyShow],
  }),
  breadcrumbSchema([
    { name: "Início", path: "/" },
    { name: "Podcast", path: PODCAST.basePath },
  ]),
];
---

<BaseLayout
  title={`Podcast ${PODCAST.name}: Psicologia sem complicações`}
  description={PODCAST.description}
  canonicalPath={PODCAST.basePath}
  schema={schemas}
  hideWhatsAppFab
  hideFunnelLinks
>
  <header class="pod-hero">
    <div class="container pod-hero-inner">
      <img class="pod-cover" src={PODCAST.cover} alt={`Capa do podcast ${PODCAST.name}`} width="200" height="200" loading="eager" />
      <div class="pod-hero-text">
        <p class="pod-eyebrow">Podcast</p>
        <h1>Podcast {PODCAST.name}</h1>
        <p class="pod-lead">{PODCAST.description}</p>
        <div class="pod-links">
          <a class="pod-badge" href={PODCAST.apple} target="_blank" rel="noopener">
            <img
              src={PODCAST.badge.apple}
              alt={PODCAST.badge.appleAlt}
              width={PODCAST.badge.appleWidth}
              height={PODCAST.badge.appleHeight}
            />
          </a>
          <a class="pod-badge spotify" href={PODCAST.spotifyShow} target="_blank" rel="noopener" aria-label="Ouvir no Spotify">
            <img
              src={PODCAST.badge.spotify}
              alt={PODCAST.badge.spotifyAlt}
              width={PODCAST.badge.spotifyWidth}
              height={PODCAST.badge.spotifyHeight}
            />
          </a>
          <a class="pod-btn ghost" href={PODCAST.rss} target="_blank" rel="noopener">RSS</a>
        </div>
        <p class="pod-note">Você pode ouvir todos os episódios aqui. Seguir no Apple ou no Spotify avisa você quando sai episódio novo.</p>
      </div>
    </div>
  </header>

  <section class="container pod-host-wrap">
    <article class="pod-host">
      <div>
        <p class="pod-eyebrow">Apresentado por</p>
        <h2>{PODCAST.host.name}</h2>
        <p class="pod-host-role">{PODCAST.host.role} · {PODCAST.host.crp}</p>
      </div>
      <div class="pod-host-links">
        <a href={PODCAST.host.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={PODCAST.host.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={PODCAST.host.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        <a href={PODCAST.host.lattes} target="_blank" rel="noopener">Lattes</a>
      </div>
    </article>
  </section>

  {featured && (
    <section class="container pod-featured-wrap">
      <p class="pod-eyebrow">Episódio mais recente</p>
      <article class="pod-featured">
        <h2>
          {featured.data.hubOnly
            ? featured.data.title
            : <a href={`${PODCAST.basePath}${featured.id}/`}>{featured.data.title}</a>}
        </h2>
        <p class="pod-meta">{fmtDate(featured.data.publishedAt)} · {featured.data.duration}</p>
        <p class="pod-desc">{featured.data.description}</p>
        <audio controls preload="none" src={featured.data.audioUrl}></audio>
        {!featured.data.hubOnly && (
          <a class="pod-more" href={`${PODCAST.basePath}${featured.id}/`}>Ler a transcrição completa →</a>
        )}
      </article>
    </section>
  )}

  <section class="container pod-list-wrap">
    <h2 class="pod-list-title">Todos os episódios</h2>
    <ol class="pod-list">
      {rest.map((ep) => (
        <li class="pod-item">
          <div class="pod-item-head">
            <span class="pod-num">{String(ep.data.episodeNumber).padStart(2, "0")}</span>
            <div>
              <h3>
                {ep.data.hubOnly
                  ? ep.data.title
                  : <a href={`${PODCAST.basePath}${ep.id}/`}>{ep.data.title}</a>}
              </h3>
              <p class="pod-meta">{fmtDate(ep.data.publishedAt)} · {ep.data.duration}</p>
            </div>
          </div>
          <p class="pod-desc">{ep.data.description}</p>
          <audio controls preload="none" src={ep.data.audioUrl}></audio>
          {!ep.data.hubOnly && (
            <a class="pod-more" href={`${PODCAST.basePath}${ep.id}/`}>Ler a transcrição →</a>
          )}
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .pod-hero {
    padding: 8.5rem 0 3rem;
    background: var(--background-subtle);
    border-bottom: 1px solid var(--color-border);
  }
  .pod-hero-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2.25rem;
    align-items: center;
  }
  .pod-cover {
    width: 200px;
    height: 200px;
    border-radius: var(--radius-card);
    object-fit: cover;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.14);
  }
  .pod-hero-text { flex: 1 1 340px; }
  .pod-eyebrow {
    margin-bottom: 0.4rem;
    color: var(--secondary);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pod-hero h1 {
    margin-bottom: 0.85rem;
    color: var(--text-heading);
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    line-height: 1.1;
  }
  .pod-lead {
    max-width: 52ch;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
    font-size: 1.08rem;
    line-height: 1.7;
  }
  /* gap 1rem atende Apple (>=4.1px) e Spotify (>=13px) de espaco livre. */
  .pod-links { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .pod-btn {
    padding: 0.7rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-btn);
    background: var(--background);
    color: var(--text-heading);
    font-family: var(--font-ui);
    font-size: 0.93rem;
    font-weight: 700;
    transition: var(--transition-fast);
  }
  .pod-btn:hover { border-color: var(--color-border-hover); }
  .pod-btn.primary {
    border-color: transparent;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-color);
  }
  .pod-btn.primary:hover { background: var(--btn-primary-hover-bg); }
  .pod-btn.ghost { background: transparent; color: var(--text-secondary); }
  /* ⛔ Apple: sem borda, fundo, sombra, filtro ou transform no badge.
     Espaco livre >= 1/10 da altura (41px -> 4.1px); o gap de 0.7rem cobre. */
  .pod-badge { display: inline-flex; align-items: center; }
  .pod-badge img { display: block; width: auto; height: 41px; }
  .pod-badge.spotify img { height: 26px; }
  .pod-note {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .pod-host-wrap { padding-top: 3rem; }
  .pod-host {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.6rem 1.8rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-card);
    background: var(--background-subtle);
  }
  .pod-host h2 {
    margin-bottom: 0.2rem;
    color: var(--text-heading);
    font-size: 1.5rem;
  }
  .pod-host-role {
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .pod-host-links { display: flex; flex-wrap: wrap; gap: 1.1rem; }
  .pod-host-links a {
    color: var(--secondary);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pod-featured-wrap { padding-top: 3.25rem; }
  .pod-featured {
    padding: 1.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--background-subtle);
  }
  .pod-featured h2 { margin-bottom: 0.35rem; color: var(--text-heading); font-size: clamp(1.6rem, 3.5vw, 2.15rem); }

  .pod-list-wrap { padding: 3.25rem 0 6rem; }
  .pod-list-title { margin-bottom: 1.5rem; color: var(--text-heading); font-size: 1.65rem; }
  .pod-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .pod-item {
    padding: 1.5rem 1.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--background);
  }
  .pod-item-head { display: flex; gap: 1rem; align-items: baseline; }
  .pod-num {
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: 1.05rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .pod-item h3 { margin-bottom: 0.15rem; color: var(--text-heading); font-size: 1.28rem; line-height: 1.3; }
  .pod-item h3 a, .pod-featured h2 a { color: inherit; }
  .pod-item h3 a:hover, .pod-featured h2 a:hover { color: var(--secondary); }
  .pod-meta {
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 0.87rem;
    font-weight: 600;
  }
  .pod-desc {
    margin: 0.85rem 0 1rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.7;
  }
  audio { width: 100%; margin-bottom: 0.9rem; }
  .pod-more {
    display: inline-flex;
    color: var(--secondary);
    font-family: var(--font-ui);
    font-size: 0.93rem;
    font-weight: 700;
  }
  .pod-more:hover { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 640px) {
    .pod-hero { padding-top: 7rem; }
    .pod-cover { width: 148px; height: 148px; }
    .pod-host { flex-direction: column; align-items: flex-start; }
  }
</style>
